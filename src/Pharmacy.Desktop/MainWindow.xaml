<Window x:Class="Pharmacy.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:components="clr-namespace:Pharmacy.Desktop.Components"
        Title="Logiciel Pharmacie"
        Width="1100"
        Height="700"
        MinWidth="840"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorView"
                              HostPage="wwwroot\index.html">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app"
                                      ComponentType="{x:Type components:RootComponent}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
