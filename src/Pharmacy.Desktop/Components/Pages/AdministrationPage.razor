@page "/module/administration"
@inject SecurityCoordinator Security
@inject IPermissionAuthorizer Authorizer
@inject BrandingCoordinator Branding
@inject Pharmacy.Desktop.Components.Configuration.ReceiptPrintingSettingsCoordinator ReceiptPrintingSettings

<PageTitle>Administration</PageTitle>
<div class="page-content catalog-page security-admin">
    <header class="page-header catalog-page-header" aria-labelledby="administration-title">
        <div><h1 id="administration-title">Administration</h1></div>
    </header>

    @if (denied)
    {
        <UiAlert Title="Accès refusé" Variant="UiAlertVariant.Danger"><p>Vous n’avez pas la permission d’accéder à cette page.</p></UiAlert>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Security.Message)) { <div class="security-feedback" role="status">@Security.Message</div> }
        @if (!string.IsNullOrWhiteSpace(Branding.Message)) { <div class="security-feedback" role="status">@Branding.Message</div> }
        @if (!string.IsNullOrWhiteSpace(ReceiptPrintingSettings.Message)) { <div class="security-feedback" role="status">@ReceiptPrintingSettings.Message</div> }
        @if (!string.IsNullOrWhiteSpace(brandingFileMessage)) { <div class="security-feedback" role="alert">@brandingFileMessage</div> }

        <section class="security-panel branding-admin" aria-labelledby="branding-admin-title">
            <div class="branding-admin__editor">
                <div>
                    <h2 id="branding-admin-title">Identité de la pharmacie</h2>
                    <p>Le nom, le logo et la couleur sont appliqués à la connexion et à la navigation.</p>
                </div>
                <form @onsubmit="SaveBrandingAsync" @onsubmit:preventDefault>
                    <label>Nom
                        <input required maxlength="160" autocomplete="organization" @bind="brandingName" />
                    </label>
                    <label>Logo
                        <InputFile OnChange="ReadBrandingLogoAsync"
                                   accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" />
                        <small>PNG, JPEG ou WEBP ; 2 Mo maximum.</small>
                    </label>
                    <div class="branding-admin__color-fields">
                        <label>Couleur
                            <input class="branding-admin__color-picker" type="color" aria-label="Sélecteur de couleur principale" @bind="brandingColor" />
                        </label>
                        <label>Valeur hexadécimale
                            <input required maxlength="7" pattern="#[0-9A-Fa-f]{6}" autocomplete="off" @bind="brandingColor" />
                        </label>
                    </div>
                    <button class="security-primary" disabled="@Branding.IsBusy">
                        @(Branding.IsBusy ? "Enregistrement…" : "Enregistrer l’identité")
                    </button>
                </form>
            </div>
            <div class="branding-admin__preview" style="@PreviewThemeStyle" aria-label="Aperçu de l’identité">
                <span>Aperçu</span>
                <img src="@PreviewLogoSource" alt="" />
                <strong>@brandingName</strong>
                <button type="button" tabindex="-1">Action principale</button>
            </div>
        </section>

        <section class="security-panel administration-settings" aria-labelledby="hardware-settings-title">
            <div>
                <h2 id="hardware-settings-title">Matériel et paramètres</h2>
                <p>Impression des tickets</p>
            </div>
            <label class="administration-setting-toggle">
                <input type="checkbox"
                       checked="@ReceiptPrintingSettings.ReceiptPrintingEnabled"
                       disabled="@(ReceiptPrintingSettings.IsBusy || !canConfigureDevices)"
                       @onchange="ChangeReceiptPrintingAsync" />
                <span>@(ReceiptPrintingSettings.ReceiptPrintingEnabled ? "Activée" : "Désactivée")</span>
            </label>
            @if (!ReceiptPrintingSettings.ReceiptPrintingEnabled)
            {
                <small>Aucun ticket n’est imprimé après la vente.</small>
            }
        </section>

        <nav class="security-panel administration-tools" aria-label="Outils administratifs">
            <div><h2>Outils administratifs</h2><p>Accès secondaires hors navigation principale.</p></div>
            <div class="administration-tools__links">
                @if (canViewBackups)
                {
                    <a href="/module/operations">Sauvegardes et outils</a>
                }
                @if (canViewAudit)
                {
                    <a href="/module/audit">Journal d’audit</a>
                }
                <a href="/diagnostic">Diagnostic et version</a>
            </div>
        </nav>

        <section class="security-admin__grid" aria-label="Gestion des comptes et mots de passe">
            <div class="security-admin__column">
                <div class="security-panel">
                    <h2>Réauthentification</h2>
                    <p>Valable pendant cinq minutes.</p>
                    <form @onsubmit="ReauthenticateAsync" @onsubmit:preventDefault>
                        <label>Mot de passe actuel<input type="password" autocomplete="current-password" @bind="reauthPassword" /></label>
                        <button class="security-primary">Confirmer</button>
                    </form>
                </div>
                <div class="security-panel">
                    <h2>Changer mon mot de passe</h2>
                    <form @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault>
                        <label>Mot de passe actuel<input type="password" autocomplete="current-password" @bind="currentPassword" /></label>
                        <label>Nouveau mot de passe<input type="password" autocomplete="new-password" @bind="newPassword" /></label>
                        <button class="security-primary">Changer</button>
                    </form>
                </div>
            </div>
            <div class="security-admin__column">
                <div class="security-panel">
                    <h2>Créer un compte</h2>
                    <form @onsubmit="CreateUserAsync" @onsubmit:preventDefault>
                        <label>Identifiant<input autocomplete="off" @bind="login" /></label>
                        <label>Nom affiché<input autocomplete="off" @bind="displayName" /></label>
                        <label>Mot de passe initial<input type="password" autocomplete="new-password" @bind="initialPassword" /></label>
                        <label>Rôle prédéfini ou personnalisé
                            <select @bind="selectedRoleId"><option value="0">Sélectionner</option>@foreach (var role in Security.AssignableRoles) { <option value="@role.RoleId">@role.Name</option> }</select>
                        </label>
                        <button class="security-primary" disabled="@(selectedRoleId == 0)">Créer</button>
                    </form>
                </div>
            </div>
        </section>

        <section class="security-panel security-panel--accounts">
            <h2>Employés et comptes utilisateurs</h2>
            <div class="security-table-wrap" tabindex="0"><table class="security-accounts-table"><thead><tr><th>Compte</th><th>Rôle principal</th><th>État</th><th>Dernière connexion</th><th>Ventes aujourd’hui</th><th>Montant aujourd’hui</th><th>Actions</th></tr></thead><tbody>
            @foreach (var user in Security.Users)
            {
                var employeeSummary = Security.EmployeeSummary(user.UserId);
                <tr class="@(selectedAccessUser?.UserId == user.UserId ? "security-account--selected" : null)">
                    <td><strong>@user.DisplayName</strong><small>@user.Login</small></td>
                    <td>@Security.UserRoleLabel(user)</td>
                    <td><span class="security-state-badge @(user.IsActive ? "security-state-badge--active" : null)">@(user.IsActive ? "Actif" : "Désactivé")</span></td>
                    <td>@FormatDateTime(employeeSummary?.LastLoginAtUtc)</td>
                    <td>@(employeeSummary?.SalesCount ?? 0)</td>
                    <td>@FormatMoney(employeeSummary?.GrossSalesAmount ?? 0m)</td>
                    <td><div class="security-account-actions">
                    @if (canViewEmployeeActivity)
                    {
                        <button type="button" @onclick="() => OpenEmployeeActivityAsync(user.UserId)">Voir l’activité</button>
                    }
                    @if (!user.Roles.Contains(SecurityRolePresets.OwnerCode, StringComparer.Ordinal))
                    {
                        <button @onclick="() => Security.SetUserActiveAsync(user, !user.IsActive)">@(user.IsActive ? "Désactiver" : "Réactiver")</button>
                    }
                    else
                    {
                        <span class="security-system-role">Compte principal protégé</span>
                    }
                    <button @onclick="() => Security.GenerateRecoveryCodesAsync(user)">Régénérer les codes</button>
                    @if (canManageRoles)
                    {
                        @if (!user.Roles.Contains(SecurityRolePresets.OwnerCode, StringComparer.Ordinal))
                        {
                            <select aria-label="Rôle à affecter" @bind="roleAssignmentId"><option value="0">Rôle…</option>@foreach (var role in Security.AssignableRoles) { <option value="@role.RoleId">@role.Name</option> }</select>
                            <button disabled="@(roleAssignmentId == 0)" @onclick="() => Security.SetUserRoleAsync(user, roleAssignmentId)">Affecter</button>
                        }
                        <button type="button" @onclick="() => EditUserPermissions(user)">Personnaliser les permissions</button>
                    }
                </div></td></tr>
            }
            </tbody></table></div>
        </section>

        @if (canViewEmployeeActivity && Security.SelectedEmployeeActivity is { } employeeActivity)
        {
            <section class="security-panel employee-activity" aria-labelledby="employee-activity-title">
                <header class="employee-activity__heading">
                    <div>
                        <span class="employee-activity__eyebrow">Historique employé</span>
                        <h2 id="employee-activity-title">@employeeActivity.Summary.DisplayName</h2>
                        <p>Les durées indiquent uniquement l’ouverture de la session applicative, pas un temps de travail réel.</p>
                    </div>
                    <button type="button" @onclick="CloseEmployeeActivity">Fermer</button>
                </header>

                <div class="employee-activity__periods" aria-label="Période de l’activité">
                    <button type="button" aria-pressed="@(activityPeriod == "today")" @onclick="ShowTodayAsync">Aujourd’hui</button>
                    <button type="button" aria-pressed="@(activityPeriod == "7days")" @onclick="ShowSevenDaysAsync">7 jours</button>
                    <button type="button" aria-pressed="@(activityPeriod == "30days")" @onclick="ShowThirtyDaysAsync">30 jours</button>
                </div>

                <div class="employee-activity__metrics" aria-label="Résumé de la période">
                    <div><span>Ventes</span><strong>@employeeActivity.Summary.SalesCount</strong></div>
                    <div><span>Ventes brutes</span><strong>@FormatMoney(employeeActivity.Summary.GrossSalesAmount)</strong></div>
                    <div><span>Retours effectués</span><strong>@employeeActivity.Summary.ReturnsPerformedCount</strong></div>
                    <div><span>Montant remboursé</span><strong>@FormatMoney(employeeActivity.Summary.RefundAmount)</strong></div>
                </div>

                <div class="employee-activity__tabs" role="tablist" aria-label="Détail employé">
                    @foreach (var tab in EmployeeTabs)
                    {
                        <button type="button" role="tab" aria-selected="@(employeeTab == tab.Code)" @onclick="() => employeeTab = tab.Code">@tab.Label</button>
                    }
                </div>

                @if (employeeTab == "summary")
                {
                    <div class="employee-activity__summary" role="tabpanel">
                        <dl>
                            <div><dt>Compte</dt><dd>@employeeActivity.Summary.Login</dd></div>
                            <div><dt>Statut</dt><dd>@(employeeActivity.Summary.IsActive ? "Actif" : "Désactivé")</dd></div>
                            <div><dt>Dernière connexion</dt><dd>@FormatDateTime(employeeActivity.Summary.LastLoginAtUtc)</dd></div>
                            <div><dt>Session courante</dt><dd>@(employeeActivity.Summary.CurrentSessionStartedAtUtc is null ? "Aucune" : $"En cours depuis {FormatDateTime(employeeActivity.Summary.CurrentSessionStartedAtUtc)}")</dd></div>
                        </dl>
                    </div>
                }
                else if (employeeTab == "sessions")
                {
                    <div class="security-table-wrap" role="tabpanel" tabindex="0">
                        <table><thead><tr><th>Début</th><th>Fin</th><th>Durée de session</th><th>État</th></tr></thead><tbody>
                        @foreach (var item in employeeActivity.Sessions)
                        {
                            <tr><td>@FormatDateTime(item.StartedAtUtc)</td><td>@FormatDateTime(item.EndedAtUtc)</td><td>@FormatDuration(item)</td><td>@SessionStatus(item)</td></tr>
                        }
                        </tbody></table>
                        @if (employeeActivity.Sessions.Count == 0) { <p class="security-empty-state">Aucune session enregistrée.</p> }
                    </div>
                }
                else if (employeeTab == "sales")
                {
                    <div class="security-table-wrap" role="tabpanel" tabindex="0">
                        <table><thead><tr><th>Vente</th><th>Date</th><th>Montant</th></tr></thead><tbody>
                        @foreach (var item in employeeActivity.Sales)
                        {
                            <tr><td><strong>@item.Reference</strong></td><td>@FormatDateTime(item.CompletedAtUtc)</td><td>@FormatMoney(item.Amount)</td></tr>
                        }
                        </tbody></table>
                        @if (employeeActivity.Sales.Count == 0) { <p class="security-empty-state">Aucune vente sur cette période.</p> }
                    </div>
                }
                else
                {
                    <div class="security-table-wrap" role="tabpanel" tabindex="0">
                        <table><thead><tr><th>Date</th><th>Catégorie</th><th>Action</th><th>Référence</th><th>Montant</th></tr></thead><tbody>
                        @foreach (var item in employeeActivity.Activity)
                        {
                            <tr><td>@FormatDateTime(item.OccurredAtUtc)</td><td>@item.Category</td><td>@item.Action</td><td>@(item.BusinessReference ?? "—")</td><td>@(item.Amount is null ? "—" : FormatMoney(item.Amount.Value))</td></tr>
                        }
                        </tbody></table>
                        @if (employeeActivity.Activity.Count == 0) { <p class="security-empty-state">Aucune activité métier sur cette période.</p> }
                    </div>
                }
            </section>
        }

        @if (canManageRoles && selectedAccessUser is not null)
        {
            <section class="security-panel security-user-access" aria-labelledby="security-user-access-title">
                <header class="security-user-access__heading">
                    <div>
                        <h2 id="security-user-access-title">Permissions de @selectedAccessUser.DisplayName</h2>
                        <p>Rôle : <strong>@Security.UserRoleLabel(selectedAccessUser)</strong>. Un refus personnalisé est prioritaire sur le rôle.</p>
                    </div>
                    <button type="button" @onclick="CloseUserPermissions">Fermer</button>
                </header>

                <div class="security-permission-groups">
                    @foreach (var module in Security.Permissions.GroupBy(permission => permission.Module).OrderBy(group => group.Key, StringComparer.Ordinal))
                    {
                        <section class="security-permission-group">
                            <h3>@SecurityPermissionPresentation.ModuleLabel(module.Key)</h3>
                            @foreach (var permission in module.OrderBy(item => item.Code, StringComparer.Ordinal))
                            {
                                <div class="security-user-permission-row">
                                    <span>
                                        <strong>@SecurityPermissionPresentation.PermissionLabel(permission.Code)</strong>
                                        <small>@(IsInherited(permission.PermissionId) ? "Incluse dans le rôle" : "Non incluse dans le rôle")</small>
                                    </span>
                                    <select aria-label="Personnalisation pour @SecurityPermissionPresentation.PermissionLabel(permission.Code)"
                                            value="@OverrideValue(permission.PermissionId)"
                                            @onchange="args => ChangeOverride(permission.PermissionId, args)">
                                        <option value="Role">Rôle uniquement</option>
                                        <option value="Allow">Autoriser</option>
                                        <option value="Deny">Refuser</option>
                                    </select>
                                </div>
                            }
                        </section>
                    }
                </div>

                <div class="security-user-access__actions">
                    <button class="security-primary" disabled="@Security.IsBusy" @onclick="SaveUserPermissionsAsync">Enregistrer les personnalisations</button>
                    @if (!confirmOverrideReset)
                    {
                        <button type="button" disabled="@(Security.IsBusy || permissionOverrides.Count == 0)" @onclick="RequestOverrideReset">Réinitialiser les personnalisations</button>
                    }
                    else
                    {
                        <button type="button" class="security-danger" disabled="@Security.IsBusy" @onclick="ResetUserPermissionsAsync">Confirmer le retour aux permissions du rôle</button>
                    }
                </div>
            </section>
        }

        @if (Security.RecoveryCodes.Count > 0)
        {
            <section class="security-recovery" role="alert"><h2>Codes de récupération à transmettre hors ligne</h2><ul>@foreach (var recoveryItem in Security.RecoveryCodes) { <li><code>@recoveryItem</code></li> }</ul></section>
        }

        @if (canManageRoles)
        {
            <section class="security-panel security-role-editor" id="security-role-editor" aria-labelledby="security-role-editor-title">
                <header class="security-role-editor__heading">
                    <div>
                        <h2 id="security-role-editor-title">@(editingRole is null ? "Créer un rôle" : $"Modifier {editingRole.Name}")</h2>
                        <p>Une réauthentification est requise pour enregistrer.</p>
                    </div>
                    @if (editingRole is not null)
                    {
                        <button type="button" disabled="@Security.IsBusy" @onclick="ResetRoleEditor">Nouveau rôle</button>
                    }
                </header>

                <form class="security-role-form" @onsubmit="SaveRoleAsync" @onsubmit:preventDefault>
                    <div class="security-role-form__identity">
                        <label>Identifiant unique
                            <input required maxlength="128" pattern="[A-Za-z][A-Za-z0-9._-]*" readonly="@(editingRole is not null)" autocomplete="off" @bind="roleCode" />
                        </label>
                        <label>Nom du rôle
                            <input required maxlength="256" autocomplete="off" @bind="roleName" />
                        </label>
                    </div>
                    <small>L’identifiant est enregistré en majuscules et ne peut plus être modifié après la création.</small>

                    <fieldset class="security-permission-selector" disabled="@Security.IsBusy">
                        <legend>Autorisations du rôle</legend>
                        @if (Security.Permissions.Count == 0)
                        {
                            <p class="security-empty-state">Aucune permission disponible. Rechargez Administration après vérification de SQL Server.</p>
                        }
                        else
                        {
                            <div class="security-permission-groups">
                                @foreach (var module in Security.Permissions.GroupBy(permission => permission.Module).OrderBy(group => group.Key, StringComparer.Ordinal))
                                {
                                    <section class="security-permission-group">
                                        <h3>@SecurityPermissionPresentation.ModuleLabel(module.Key)</h3>
                                        @foreach (var permission in module.OrderBy(item => item.Code, StringComparer.Ordinal))
                                        {
                                            <label class="security-permission-option">
                                                <input type="checkbox"
                                                       checked="@selectedPermissionIds.Contains(permission.PermissionId)"
                                                       @onchange="args => TogglePermission(permission.PermissionId, args)" />
                                                <span><strong>@SecurityPermissionPresentation.PermissionLabel(permission.Code)</strong></span>
                                            </label>
                                        }
                                    </section>
                                }
                            </div>
                        }
                    </fieldset>

                    <div class="security-role-form__actions">
                        <button class="security-primary" disabled="@(Security.IsBusy || Security.Permissions.Count == 0)">
                            @(Security.IsBusy ? "Enregistrement…" : editingRole is null ? "Créer le rôle" : "Enregistrer les permissions")
                        </button>
                        @if (editingRole is not null)
                        {
                            <button type="button" disabled="@Security.IsBusy" @onclick="ResetRoleEditor">Annuler</button>
                        }
                    </div>
                </form>
            </section>
        }

        <section class="security-panel security-panel--permissions">
            <h2>Rôles et autorisations</h2>
            @if (Security.Roles.Count == 0)
            {
                <p class="security-empty-state">Aucun rôle disponible.</p>
            }
            @foreach (var role in Security.Roles.Where(role => role.Code != SecurityRolePresets.OwnerCode))
            {
                <div class="security-role-summary">
                    <details>
                        <summary>
                            <strong>@role.Name</strong>
                            <small class="security-role-count">@AuthorizationCount(role.Permissions.Count)</small>
                        </summary>
                        @if (role.Permissions.Count == 0)
                        {
                            <p class="security-empty-state">Ce rôle n’accorde actuellement aucune permission.</p>
                        }
                        else
                        {
                            <ul>@foreach (var permission in role.Permissions) { <li>@SecurityPermissionPresentation.PermissionLabel(permission.Code)</li> }</ul>
                        }
                    </details>
                    @if (role.IsSystemRole)
                    {
                        <span class="security-system-role">Système · lecture seule</span>
                    }
                    else if (canManageRoles)
                    {
                        <button type="button" disabled="@Security.IsBusy" @onclick="() => EditRole(role)">Modifier les permissions</button>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private static readonly (string Code, string Label)[] EmployeeTabs =
    [
        ("summary", "Résumé"),
        ("sessions", "Sessions"),
        ("sales", "Ventes"),
        ("activity", "Activité")
    ];
    private static string AuthorizationCount(int count) => $"{count} {(count == 1 ? "autorisation" : "autorisations")}";
    private bool denied, canManageRoles, canViewEmployeeActivity, canConfigureDevices, canViewBackups, canViewAudit;
    private string reauthPassword = string.Empty, login = string.Empty, displayName = string.Empty, initialPassword = string.Empty;
    private string currentPassword = string.Empty, newPassword = string.Empty;
    private string roleCode = string.Empty, roleName = string.Empty;
    private string brandingName = string.Empty, brandingColor = string.Empty;
    private string? brandingFileMessage, pendingLogoMimeType, pendingLogoFileName, pendingLogoSource;
    private byte[]? pendingLogoContent;
    private long selectedRoleId, roleAssignmentId;
    private SecurityRoleView? editingRole;
    private SecurityUserSummaryView? selectedAccessUser;
    private long? selectedEmployeeActivityUserId;
    private string activityPeriod = "today", employeeTab = "summary";
    private bool confirmOverrideReset;
    private readonly HashSet<long> selectedPermissionIds = new();
    private readonly Dictionary<long, SecurityPermissionOverrideEffect> permissionOverrides = new();
    protected override async Task OnInitializedAsync()
    {
        denied = Authorizer.Authorize(SecurityPermissions.SecurityManageUsers).IsFailure;
        canManageRoles = Authorizer.Authorize(SecurityPermissions.SecurityManageRoles).IsSuccess;
        canViewEmployeeActivity = Authorizer.Authorize(SecurityPermissions.SecurityViewEmployeeActivity).IsSuccess;
        canConfigureDevices = Authorizer.Authorize(SecurityPermissions.DevicesConfigure).IsSuccess;
        canViewBackups = Authorizer.Authorize(SecurityPermissions.BackupView).IsSuccess;
        canViewAudit = Authorizer.Authorize(SecurityPermissions.AuditView).IsSuccess;
        if (!denied)
        {
            SyncBrandingForm();
            await Security.LoadAdministrationAsync();
        }
    }

    private Task ChangeReceiptPrintingAsync(ChangeEventArgs args)
    {
        var enabled = args.Value is true
            || bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        return ReceiptPrintingSettings.UpdateAsync(enabled);
    }

    private async Task OpenEmployeeActivityAsync(long userId)
    {
        selectedEmployeeActivityUserId = userId;
        activityPeriod = "today";
        employeeTab = "summary";
        await Security.LoadEmployeeActivityAsync(userId, CurrentActivityPeriod());
    }

    private async Task ChangeActivityPeriodAsync(string period)
    {
        if (selectedEmployeeActivityUserId is null) return;
        activityPeriod = period;
        await Security.LoadEmployeeActivityAsync(selectedEmployeeActivityUserId.Value, CurrentActivityPeriod());
    }

    private Task ShowTodayAsync() => ChangeActivityPeriodAsync("today");
    private Task ShowSevenDaysAsync() => ChangeActivityPeriodAsync("7days");
    private Task ShowThirtyDaysAsync() => ChangeActivityPeriodAsync("30days");

    private EmployeeActivityPeriod CurrentActivityPeriod()
    {
        var nowUtc = DateTime.UtcNow;
        return activityPeriod switch
        {
            "7days" => EmployeeActivityPeriod.LastDays(nowUtc, 7),
            "30days" => EmployeeActivityPeriod.LastDays(nowUtc, 30),
            _ => EmployeeActivityPeriod.Today(nowUtc)
        };
    }

    private void CloseEmployeeActivity()
    {
        selectedEmployeeActivityUserId = null;
        Security.CloseEmployeeActivity();
    }

    private static string FormatDateTime(DateTime? value) => value is null
        ? "Jamais"
        : value.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    private static string FormatMoney(decimal value) => $"{value:N2} MAD";

    private static string FormatDuration(EmployeeSessionHistoryView session) => session.Duration is null
        ? session.Status == "Open" ? "En cours" : "Indéterminée"
        : $"{(int)session.Duration.Value.TotalHours} h {session.Duration.Value.Minutes:00}";

    private static string SessionStatus(EmployeeSessionHistoryView session) => session.Status switch
    {
        "Open" => "En cours",
        "Closed" => session.EndReason == "ApplicationExit" ? "Fermeture application" : "Déconnexion",
        "Interrupted" => "Interrompue — fin inconnue",
        _ => "Inconnue"
    };
    private async Task ReauthenticateAsync() { await Security.ReauthenticateAsync(reauthPassword); reauthPassword = string.Empty; }
    private async Task CreateUserAsync()
    {
        await Security.CreateUserAsync(login, displayName, initialPassword, new[] { selectedRoleId });
        initialPassword = string.Empty;
    }
    private async Task ChangePasswordAsync()
    {
        await Security.ChangePasswordAsync(currentPassword, newPassword);
        currentPassword = newPassword = string.Empty;
    }

    private string PreviewLogoSource => pendingLogoSource ?? Branding.LogoSource;

    private string PreviewThemeStyle
    {
        get
        {
            try { return BrandingCoordinator.BuildThemeStyle(brandingColor); }
            catch (FormatException) { return Branding.ThemeStyle; }
            catch (ArgumentOutOfRangeException) { return Branding.ThemeStyle; }
        }
    }

    private async Task ReadBrandingLogoAsync(InputFileChangeEventArgs args)
    {
        brandingFileMessage = null;
        pendingLogoContent = null;
        pendingLogoMimeType = null;
        pendingLogoFileName = null;
        pendingLogoSource = null;
        var file = args.File;
        if (file.Size <= 0 || file.Size > Pharmacy.Application.Branding.PharmacyBrandingDefaults.MaxLogoBytes)
        {
            brandingFileMessage = "Le logo doit être non vide et ne pas dépasser 2 Mo.";
            return;
        }

        try
        {
            await using var stream = file.OpenReadStream(Pharmacy.Application.Branding.PharmacyBrandingDefaults.MaxLogoBytes);
            using var buffer = new MemoryStream((int)file.Size);
            await stream.CopyToAsync(buffer);
            var content = buffer.ToArray();
            var validation = Pharmacy.Application.Branding.PharmacyBrandingValidator.ValidateLogo(content, file.ContentType, file.Name);
            if (validation.IsFailure)
            {
                brandingFileMessage = validation.Error.Message;
                return;
            }

            pendingLogoContent = content;
            pendingLogoMimeType = file.ContentType;
            pendingLogoFileName = file.Name;
            pendingLogoSource = $"data:{file.ContentType};base64,{Convert.ToBase64String(content)}";
        }
        catch (IOException)
        {
            brandingFileMessage = "Le logo n’a pas pu être lu. Sélectionnez un autre fichier.";
        }
    }

    private async Task SaveBrandingAsync()
    {
        var saved = await Branding.UpdateAsync(
            brandingName,
            brandingColor,
            pendingLogoContent,
            pendingLogoMimeType,
            pendingLogoFileName);
        if (saved) SyncBrandingForm();
    }

    private void SyncBrandingForm()
    {
        brandingName = Branding.Current.PharmacyName;
        brandingColor = Branding.Current.PrimaryColor;
        pendingLogoContent = null;
        pendingLogoMimeType = null;
        pendingLogoFileName = null;
        pendingLogoSource = null;
        brandingFileMessage = null;
    }

    private void EditRole(SecurityRoleView role)
    {
        if (role.IsSystemRole) return;
        editingRole = role;
        roleCode = role.Code;
        roleName = role.Name;
        selectedPermissionIds.Clear();
        selectedPermissionIds.UnionWith(role.Permissions.Select(permission => permission.PermissionId));
    }

    private void ResetRoleEditor()
    {
        editingRole = null;
        roleCode = roleName = string.Empty;
        selectedPermissionIds.Clear();
    }

    private void TogglePermission(long permissionId, ChangeEventArgs args)
    {
        if (args.Value is true || bool.TryParse(args.Value?.ToString(), out var selected) && selected)
            selectedPermissionIds.Add(permissionId);
        else
            selectedPermissionIds.Remove(permissionId);
    }

    private async Task SaveRoleAsync()
    {
        var permissionIds = selectedPermissionIds.Order().ToArray();
        var saved = editingRole is null
            ? await Security.CreateRoleAsync(roleCode, roleName, permissionIds)
            : await Security.UpdateRoleAsync(editingRole, roleName, permissionIds);
        if (saved) ResetRoleEditor();
    }

    private void EditUserPermissions(SecurityUserSummaryView user)
    {
        selectedAccessUser = user;
        permissionOverrides.Clear();
        foreach (var item in user.PermissionOverrides) permissionOverrides[item.PermissionId] = item.Effect;
        confirmOverrideReset = false;
    }

    private void CloseUserPermissions()
    {
        selectedAccessUser = null;
        permissionOverrides.Clear();
        confirmOverrideReset = false;
    }

    private bool IsInherited(long permissionId)
    {
        if (selectedAccessUser is null) return false;
        return Security.Roles
            .Where(role => selectedAccessUser.Roles.Contains(role.Code, StringComparer.Ordinal))
            .SelectMany(role => role.Permissions)
            .Any(permission => permission.PermissionId == permissionId);
    }

    private string OverrideValue(long permissionId) => permissionOverrides.TryGetValue(permissionId, out var effect)
        ? effect.ToString()
        : "Role";

    private void ChangeOverride(long permissionId, ChangeEventArgs args)
    {
        confirmOverrideReset = false;
        var value = args.Value?.ToString();
        if (Enum.TryParse<SecurityPermissionOverrideEffect>(value, out var effect)) permissionOverrides[permissionId] = effect;
        else permissionOverrides.Remove(permissionId);
    }

    private async Task SaveUserPermissionsAsync()
    {
        if (selectedAccessUser is null) return;
        var userId = selectedAccessUser.UserId;
        var selections = permissionOverrides.OrderBy(item => item.Key)
            .Select(item => new SecurityPermissionOverrideSelection(item.Key, item.Value)).ToArray();
        if (await Security.SetUserPermissionOverridesAsync(selectedAccessUser, selections))
            EditUserPermissions(Security.Users.Single(user => user.UserId == userId));
    }

    private void RequestOverrideReset() => confirmOverrideReset = true;

    private async Task ResetUserPermissionsAsync()
    {
        if (selectedAccessUser is null) return;
        var userId = selectedAccessUser.UserId;
        if (await Security.SetUserPermissionOverridesAsync(selectedAccessUser, Array.Empty<SecurityPermissionOverrideSelection>()))
            EditUserPermissions(Security.Users.Single(user => user.UserId == userId));
    }
}
