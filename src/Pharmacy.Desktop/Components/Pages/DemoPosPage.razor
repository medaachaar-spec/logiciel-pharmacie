@page "/module/sales"
@implements IAsyncDisposable
@inject SalesPosCoordinator Session
@inject NavigationManager Navigation

<PageTitle>Nouvelle vente — Logiciel Pharmacie</PageTitle>

<div class="page-content pos-page">
    <header class="page-header pos-page-header">
        <div>
            <p class="pos-kicker">Ventes</p>
            <h1>Nouvelle vente</h1>
            <p class="page-subtitle">Continuité de vente avec données exclusivement synthétiques.</p>
        </div>
    </header>

    <UiAlert Title="Mode démonstration — Catalogue SQL et brouillon Sales en mémoire"
             Variant="UiAlertVariant.Warning">
        La recherche et les prix viennent de SQL Server. Panier, stock synthétique, paiements, suspensions et impressions restent en mémoire ; aucune vente n’est persistée.
    </UiAlert>

    @if (Session.IsInitializing)
    {
        <section class="pos-panel pos-loading" role="status" aria-live="polite">
            <UiSpinner Label="Initialisation du brouillon Sales Application" />
        </section>
    }
    else if (Session.CurrentDraft is null)
    {
        <UiAlert Title="Le brouillon Sales Application n’a pas pu être initialisé"
                 Variant="UiAlertVariant.Danger">
            <p>@Session.UserMessage</p>
            <UiButton OnClick="RetryInitializationAsync">Réessayer l’initialisation</UiButton>
        </UiAlert>
    }
    else
    {
        @if (Session.Step != DemoPosStep.Success)
        {
            <section class="pos-session-strip" aria-label="État du brouillon Sales Application">
                <UiBadge Text="Catalogue SQL — brouillon mémoire" Variant="UiBadgeVariant.Information" />
                <span><strong>Brouillon</strong> @DraftReference</span>
                <span><strong>Version</strong> @Session.CurrentDraft.Version</span>
                <span><strong>Lignes</strong> @Session.CurrentDraft.LineCount</span>
                <span><strong>Total</strong> @DemoMoney.Format(Session.Total)</span>
            </section>

            <nav class="pos-continuity-actions" aria-label="Actions de continuité de la vente">
                <UiButton Variant="UiButtonVariant.Secondary"
                          Disabled="@(!Session.CanSuspend || isCompleting)"
                          OnClick="RequestSuspendAsync">
                    Suspendre la vente
                </UiButton>
                <UiButton Variant="UiButtonVariant.Secondary"
                          Disabled="@(Session.CurrentDraft.IsEmpty || Session.IsCartMutationInProgress || isCompleting)"
                          OnClick="RequestClearAsync">
                    Vider le panier
                </UiButton>
                <UiButton Variant="UiButtonVariant.Danger"
                          Disabled="@(!Session.CanAbandon || isCompleting)"
                          OnClick="RequestAbandonAsync">
                    Abandonner le brouillon
                </UiButton>
                <UiButton Variant="UiButtonVariant.Secondary"
                          aria-expanded="@showSuspendedSales.ToString().ToLowerInvariant()"
                          aria-controls="demo-suspended-sales"
                          Disabled="@Session.IsContinuityActionInProgress"
                          OnClick="ToggleSuspendedSalesAsync">
                    Ventes suspendues (@Session.SuspendedDrafts.Count)
                </UiButton>
            </nav>
        }

        @if (confirmationKind != ConfirmationKind.None)
        {
            <section class="pos-confirmation"
                     @ref="confirmationFocus"
                     tabindex="-1"
                     role="alertdialog"
                     aria-modal="true"
                     aria-labelledby="continuity-confirmation-title"
                     @onkeydown="HandleConfirmationKeyDownAsync">
                <div>
                    <h2 id="continuity-confirmation-title">@ConfirmationTitle</h2>
                    <p>@ConfirmationMessage</p>
                </div>
                <div class="pos-confirmation__actions">
                    @if (confirmationKind == ConfirmationKind.ResumeConflict)
                    {
                        <UiButton Variant="UiButtonVariant.Secondary" OnClick="CancelConfirmationAsync">
                            Revenir au panier courant
                        </UiButton>
                        <UiButton Disabled="@Session.IsContinuityActionInProgress" OnClick="ConfirmSuspendThenResumeAsync">
                            Suspendre le panier courant puis reprendre
                        </UiButton>
                        <UiButton Variant="UiButtonVariant.Danger"
                                  Disabled="@Session.IsContinuityActionInProgress"
                                  OnClick="ConfirmAbandonThenResumeAsync">
                            Abandonner le panier courant puis reprendre
                        </UiButton>
                    }
                    else
                    {
                        <UiButton Variant="UiButtonVariant.Secondary" OnClick="CancelConfirmationAsync">Annuler</UiButton>
                        @if (confirmationKind == ConfirmationKind.Suspend)
                        {
                            <UiButton Disabled="@Session.IsContinuityActionInProgress" OnClick="ConfirmSuspendAsync">
                                Confirmer la suspension
                            </UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.Clear)
                        {
                            <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmClearAsync">Confirmer le vidage</UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.Abandon)
                        {
                            <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmAbandonAsync">Confirmer l’abandon</UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.DeleteSuspended)
                        {
                            <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmDeleteSuspendedAsync">
                                Confirmer la suppression
                            </UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.ResolveCardConfirmed)
                        {
                            <UiButton OnClick="ConfirmResolveCardConfirmedAsync">Confirmer le paiement après vérification</UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.ResolveCardNotCompleted)
                        {
                            <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmResolveCardNotCompletedAsync">
                                Confirmer le paiement non réalisé
                            </UiButton>
                        }
                        else if (confirmationKind == ConfirmationKind.ReturnCardToPaymentChoice)
                        {
                            <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmReturnCardToPaymentChoiceAsync">
                                Confirmer le retour au choix du paiement
                            </UiButton>
                        }
                    }
                </div>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(Session.UserMessage)
            && Session.LastErrorCode is not "sales.product.not_found" and not "sales.stock.insufficient_availability")
        {
            @if (Session.LastErrorCode is null)
            {
                <p class="pos-notice" role="status" aria-live="polite">@Session.UserMessage</p>
            }
            else
            {
                <UiAlert Title="Action non réalisée"
                         Variant="@(Session.LastErrorCode == "sales.pos.unexpected" ? UiAlertVariant.Danger : UiAlertVariant.Warning)">
                    @Session.UserMessage
                </UiAlert>
            }
        }

        @if (showSuspendedSales && Session.Step != DemoPosStep.Success)
        {
            <div id="demo-suspended-sales">
                <DemoSuspendedSalesPanel Sales="Session.SuspendedDrafts"
                                         OnResume="ResumeSuspendedAsync"
                                         OnDelete="RequestDeleteSuspendedAsync" />
            </div>
        }

        @if (Session.Step == DemoPosStep.Shopping)
        {
            <div class="pos-layout">
                <div class="pos-main-column">
                    <section class="pos-search" aria-labelledby="demo-search-title" aria-busy="@Session.IsSearching.ToString().ToLowerInvariant()">
                        <div class="pos-search__heading">
                            <div>
                                <p class="pos-kicker">Recherche Application</p>
                                <h2 id="demo-search-title">Rechercher ou scanner un code</h2>
                            </div>
                            <span>Entrée ajoute un code exact</span>
                        </div>
                        <label class="sr-only" for="demo-pos-search">Rechercher ou scanner un code</label>
                        <div class="pos-search__control">
                            <input id="demo-pos-search"
                                   @ref="searchInput"
                                   class="ui-field__control"
                                   type="search"
                                   autocomplete="off"
                                   spellcheck="false"
                                   placeholder="Nom fictif ou DEMO-000001"
                                   value="@searchTerm"
                                   aria-describedby="demo-search-help demo-search-message"
                                   disabled="@(Session.IsCartMutationInProgress || Session.IsContinuityActionInProgress)"
                                   @oninput="HandleSearchInputAsync"
                                   @onkeydown="HandleSearchKeyDownAsync" />
                            <UiButton Variant="UiButtonVariant.Secondary"
                                      Disabled="@(string.IsNullOrWhiteSpace(searchTerm) || Session.IsSearching)"
                                      OnClick="ClearSearchAsync">
                                Effacer la recherche
                            </UiButton>
                        </div>
                        <p id="demo-search-help" class="ui-field__help">
                            Recherche Application insensible à la casse, sans appel réseau ni création automatique.
                        </p>
                        <div id="demo-search-message" aria-live="polite">
                            @if (Session.LastErrorCode == "sales.product.not_found")
                            {
                                <UiAlert Title="Code inconnu" Variant="UiAlertVariant.Warning">
                                    <p>Aucun produit synthétique ne correspond à ce code. Aucun produit n’a été créé.</p>
                                    <div class="pos-incident-actions">
                                        <UiButton Size="UiButtonSize.Small" Variant="UiButtonVariant.Secondary" OnClick="ClearSearchAsync">
                                            Effacer la recherche
                                        </UiButton>
                                        <UiButton Size="UiButtonSize.Small" OnClick="ReturnToCatalogAsync">Revenir au catalogue</UiButton>
                                    </div>
                                </UiAlert>
                            }
                            else if (!string.IsNullOrWhiteSpace(searchTerm) && Session.SearchResults.Count == 0)
                            {
                                <p class="ui-field__error" role="status">Aucun résultat vendable dans le Catalogue SQL.</p>
                            }
                            else if (Session.IsSearching)
                            {
                                <p role="status">Recherche en cours…</p>
                            }
                        </div>
                    </section>

                    <DemoCatalogPanel Items="Session.SearchResults"
                                      IsBusy="Session.IsCartMutationInProgress"
                                      BusyProductId="Session.BusyProductId"
                                      OnAdd="AddItemAsync" />
                </div>

                <aside class="pos-side-column" aria-label="Panier Sales Application">
                    <DemoCartPanel Session="Session"
                                   AvailabilityIncident="Session.AvailabilityIncident"
                                   OnDismissAvailability="DismissAvailabilityAsync"
                                   OnIncrease="IncreaseAsync"
                                   OnDecrease="DecreaseAsync"
                                   OnRemove="RemoveAsync"
                                   OnCheckout="BeginPaymentAsync" />
                </aside>
            </div>
        }
        else if (Session.Step == DemoPosStep.Payment)
        {
            <div class="pos-layout pos-layout--payment" @ref="paymentFocus" tabindex="-1">
                <div class="pos-main-column">
                    <DemoPaymentPanel Session="Session"
                                      IsCompleting="isCompleting"
                                      OnBack="ReturnToCartAsync"
                                      OnConfirm="CompleteSaleAsync"
                                      OnResolveCardConfirmed="RequestResolveCardConfirmedAsync"
                                      OnResolveCardNotCompleted="RequestResolveCardNotCompletedAsync"
                                      OnReturnAmbiguousToPaymentChoice="RequestReturnCardToPaymentChoiceAsync" />
                </div>
                <aside class="pos-side-column" aria-label="Résumé du panier Application">
                    <DemoCartPanel Session="Session" ReadOnly="true" />
                </aside>
            </div>
        }
        else if (Session.Result is not null)
        {
            <div @ref="successFocus" tabindex="-1" class="pos-success-focus">
                <DemoPosSuccess Session="Session" OnNewSale="StartNewSaleAsync" OnHome="ReturnHomeAsync" />
            </div>
        }
    }
</div>

@code {
    private readonly CancellationTokenSource lifetimeCancellation = new();
    private ElementReference searchInput;
    private ElementReference paymentFocus;
    private ElementReference successFocus;
    private ElementReference confirmationFocus;
    private string searchTerm = string.Empty;
    private string? pendingSuspendedReference;
    private bool showSuspendedSales;
    private bool isCompleting;
    private ConfirmationKind confirmationKind;
    private FocusTarget requestedFocus = FocusTarget.Search;

    private CancellationToken CancellationToken => lifetimeCancellation.Token;

    private string DraftReference => Session.CurrentDraft is null
        ? "—"
        : Session.CurrentDraft.Id.Value.ToString("N")[..8].ToUpperInvariant();

    private string ConfirmationTitle => confirmationKind switch
    {
        ConfirmationKind.Suspend => "Suspendre la vente courante ?",
        ConfirmationKind.Clear => "Vider le panier ?",
        ConfirmationKind.Abandon => "Abandonner le brouillon ?",
        ConfirmationKind.DeleteSuspended => $"Supprimer {pendingSuspendedReference} ?",
        ConfirmationKind.ResumeConflict => "Un panier est déjà en cours",
        ConfirmationKind.ResolveCardConfirmed => "Confirmer le résultat du TPE ?",
        ConfirmationKind.ResolveCardNotCompleted => "Déclarer le paiement non réalisé ?",
        ConfirmationKind.ReturnCardToPaymentChoice => "Quitter le statut incertain ?",
        _ => string.Empty
    };

    private string ConfirmationMessage => confirmationKind switch
    {
        ConfirmationKind.Suspend =>
            "Un instantané Application immuable sera conservé en mémoire Desktop. Le paiement courant sera perdu et un nouveau brouillon Application sera créé.",
        ConfirmationKind.Clear =>
            "Toutes les lignes seront retirées via Application. Tout paiement incomplet sera réinitialisé.",
        ConfirmationKind.Abandon =>
            "Toutes les lignes et tout paiement incomplet du brouillon courant seront supprimés. Les suspensions existantes resteront disponibles.",
        ConfirmationKind.DeleteSuspended =>
            "Cette suspension en mémoire Desktop sera supprimée définitivement de la session de démonstration.",
        ConfirmationKind.ResumeConflict =>
            $"La reprise de {pendingSuspendedReference} ne doit pas écraser le panier courant. Choisissez explicitement de le suspendre ou de l’abandonner.",
        ConfirmationKind.ResolveCardConfirmed =>
            "Confirmez uniquement après avoir vérifié le résultat affiché par le TPE externe simulé. Aucun nouveau paiement ne sera lancé.",
        ConfirmationKind.ResolveCardNotCompleted =>
            "Le paiement carte sera marqué non réalisé et la vente restera non validable.",
        ConfirmationKind.ReturnCardToPaymentChoice =>
            "Le statut incertain sera effacé sans relancer de paiement. Vérifiez le TPE externe avant de poursuivre.",
        _ => string.Empty
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync(CancellationToken);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && requestedFocus == FocusTarget.None)
        {
            return;
        }

        var target = firstRender ? FocusTarget.Search : requestedFocus;
        requestedFocus = FocusTarget.None;

        try
        {
            if (target == FocusTarget.Search && Session.Step == DemoPosStep.Shopping && Session.CurrentDraft is not null)
            {
                await searchInput.FocusAsync();
            }
            else if (target == FocusTarget.Payment && Session.Step == DemoPosStep.Payment)
            {
                await paymentFocus.FocusAsync();
            }
            else if (target == FocusTarget.Success && Session.Step == DemoPosStep.Success)
            {
                await successFocus.FocusAsync();
            }
            else if (target == FocusTarget.Confirmation && confirmationKind != ConfirmationKind.None)
            {
                await confirmationFocus.FocusAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // The native WebView can be closing while a local focus request is pending.
        }
    }

    private async Task RetryInitializationAsync(MouseEventArgs _)
    {
        await Session.InitializeAsync(CancellationToken);
        requestedFocus = FocusTarget.Search;
    }

    private async Task HandleSearchInputAsync(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        Session.ClearFeedback();
        await Session.SearchAsync(searchTerm, CancellationToken);
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            return;
        }

        var added = await Session.AddExactCodeAsync(searchTerm, CancellationToken);

        if (added)
        {
            searchTerm = string.Empty;
            await Session.SearchAsync(searchTerm, CancellationToken);
        }

        requestedFocus = FocusTarget.Search;
    }

    private async Task AddItemAsync(ProductId productId)
    {
        await Session.AddProductAsync(productId, CancellationToken);
        requestedFocus = FocusTarget.Search;
    }

    private async Task IncreaseAsync(ProductId productId)
    {
        var line = Session.CurrentDraft?.Lines.FirstOrDefault(candidate => candidate.ProductId == productId);

        if (line is not null)
        {
            await Session.ChangeQuantityAsync(productId, checked(line.Quantity.Value + 1), CancellationToken);
        }
    }

    private async Task DecreaseAsync(ProductId productId)
    {
        var line = Session.CurrentDraft?.Lines.FirstOrDefault(candidate => candidate.ProductId == productId);

        if (line is not null)
        {
            await Session.ChangeQuantityAsync(productId, line.Quantity.Value - 1, CancellationToken);
        }
    }

    private async Task RemoveAsync(ProductId productId)
    {
        await Session.RemoveItemAsync(productId, CancellationToken);
    }

    private Task BeginPaymentAsync()
    {
        if (Session.BeginPayment())
        {
            CloseConfirmation();
            Session.ClearFeedback();
            requestedFocus = FocusTarget.Payment;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task ReturnToCartAsync()
    {
        Session.ReturnToShopping();
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private async Task CompleteSaleAsync()
    {
        if (!Session.TryBeginCompletion())
        {
            return;
        }

        isCompleting = true;
        CloseConfirmation();

        try
        {
            await Task.Delay(180, CancellationToken);
            Session.CompleteSale();
            requestedFocus = FocusTarget.Success;
        }
        catch (OperationCanceledException) when (CancellationToken.IsCancellationRequested)
        {
            Session.CancelCompletion();
        }
        catch (Exception exception)
        {
            Session.CancelCompletion();
            Session.ReportUnexpectedFailure("payment-simulation", exception);
        }
        finally
        {
            isCompleting = false;
        }
    }

    private Task RequestSuspendAsync(MouseEventArgs _) => ShowConfirmationAsync(ConfirmationKind.Suspend);

    private Task RequestClearAsync(MouseEventArgs _) => ShowConfirmationAsync(ConfirmationKind.Clear);

    private Task RequestAbandonAsync(MouseEventArgs _) => ShowConfirmationAsync(ConfirmationKind.Abandon);

    private async Task ConfirmSuspendAsync(MouseEventArgs _)
    {
        CloseConfirmation();
        if (await Session.SuspendCurrentDraftAsync(CancellationToken))
        {
            ResetShoppingState();
            showSuspendedSales = true;
        }
    }

    private async Task ConfirmClearAsync(MouseEventArgs _)
    {
        CloseConfirmation();
        if (await Session.ClearAsync(CancellationToken))
        {
            ResetShoppingState();
        }
    }

    private async Task ConfirmAbandonAsync(MouseEventArgs _)
    {
        CloseConfirmation();
        if (await Session.AbandonCurrentDraftAsync(CancellationToken))
        {
            ResetShoppingState();
        }
    }

    private Task ToggleSuspendedSalesAsync(MouseEventArgs _)
    {
        showSuspendedSales = !showSuspendedSales;
        return InvokeAsync(StateHasChanged);
    }

    private Task ResumeSuspendedAsync(string reference)
    {
        if (Session.CurrentDraft?.IsEmpty == false)
        {
            pendingSuspendedReference = reference;
            return ShowConfirmationAsync(ConfirmationKind.ResumeConflict);
        }

        return ResumeWithoutConflictAsync(reference);
    }

    private async Task ResumeWithoutConflictAsync(string reference)
    {
        if (await Session.ResumeSuspendedDraftAsync(reference, CancellationToken))
        {
            ResetShoppingState();
        }
    }

    private async Task ConfirmSuspendThenResumeAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        CloseConfirmation();

        if (reference is not null
            && await Session.SuspendCurrentDraftAsync(CancellationToken))
        {
            await ResumeWithoutConflictAsync(reference);
        }
    }

    private async Task ConfirmAbandonThenResumeAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        CloseConfirmation();

        if (reference is not null
            && await Session.AbandonCurrentDraftAsync(CancellationToken))
        {
            await ResumeWithoutConflictAsync(reference);
        }
    }

    private Task RequestDeleteSuspendedAsync(string reference)
    {
        pendingSuspendedReference = reference;
        return ShowConfirmationAsync(ConfirmationKind.DeleteSuspended);
    }

    private Task ConfirmDeleteSuspendedAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        if (reference is not null)
        {
            Session.DeleteSuspended(reference);
        }
        CloseConfirmation();
        Session.ClearFeedback();
        requestedFocus = Session.Step == DemoPosStep.Shopping ? FocusTarget.Search : FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task RequestResolveCardConfirmedAsync() => ShowConfirmationAsync(ConfirmationKind.ResolveCardConfirmed);

    private Task RequestResolveCardNotCompletedAsync() => ShowConfirmationAsync(ConfirmationKind.ResolveCardNotCompleted);

    private Task RequestReturnCardToPaymentChoiceAsync() => ShowConfirmationAsync(ConfirmationKind.ReturnCardToPaymentChoice);

    private Task ConfirmResolveCardConfirmedAsync(MouseEventArgs _)
    {
        Session.ResolveAmbiguousCardAsConfirmed();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmResolveCardNotCompletedAsync(MouseEventArgs _)
    {
        Session.ResolveAmbiguousCardAsNotCompleted();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmReturnCardToPaymentChoiceAsync(MouseEventArgs _)
    {
        Session.ReturnToPaymentChoice();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ShowConfirmationAsync(ConfirmationKind kind)
    {
        confirmationKind = kind;
        Session.ClearFeedback();
        requestedFocus = FocusTarget.Confirmation;
        return InvokeAsync(StateHasChanged);
    }

    private Task CancelConfirmationAsync(MouseEventArgs _)
    {
        CloseConfirmation();
        requestedFocus = Session.Step switch
        {
            DemoPosStep.Payment => FocusTarget.Payment,
            DemoPosStep.Success => FocusTarget.Success,
            _ => FocusTarget.Search
        };
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleConfirmationKeyDownAsync(KeyboardEventArgs args)
    {
        return string.Equals(args.Key, "Escape", StringComparison.Ordinal)
            ? CancelConfirmationAsync(new MouseEventArgs())
            : Task.CompletedTask;
    }

    private async Task ClearSearchAsync(MouseEventArgs _)
    {
        searchTerm = string.Empty;
        Session.ClearFeedback();
        await Session.SearchAsync(searchTerm, CancellationToken);
        requestedFocus = FocusTarget.Search;
    }

    private Task ReturnToCatalogAsync(MouseEventArgs args) => ClearSearchAsync(args);

    private Task DismissAvailabilityAsync()
    {
        Session.ClearFeedback();
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private async Task StartNewSaleAsync()
    {
        if (await Session.StartNewDraftAsync(CancellationToken))
        {
            ResetShoppingState();
            showSuspendedSales = false;
        }
    }

    private async Task ReturnHomeAsync()
    {
        await Session.StartNewDraftAsync(CancellationToken);
        Navigation.NavigateTo("/home");
    }

    private void ResetShoppingState()
    {
        searchTerm = string.Empty;
        isCompleting = false;
        requestedFocus = FocusTarget.Search;
        CloseConfirmation();
    }

    private void CloseConfirmation()
    {
        confirmationKind = ConfirmationKind.None;
        pendingSuspendedReference = null;
    }

    public ValueTask DisposeAsync()
    {
        lifetimeCancellation.Cancel();
        lifetimeCancellation.Dispose();
        return ValueTask.CompletedTask;
    }

    private enum ConfirmationKind
    {
        None,
        Suspend,
        Clear,
        Abandon,
        DeleteSuspended,
        ResumeConflict,
        ResolveCardConfirmed,
        ResolveCardNotCompleted,
        ReturnCardToPaymentChoice
    }

    private enum FocusTarget
    {
        None,
        Search,
        Payment,
        Success,
        Confirmation
    }
}
