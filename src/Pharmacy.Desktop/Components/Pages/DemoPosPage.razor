@page "/module/sales"
@inject DemoPosSession Session
@inject NavigationManager Navigation

<PageTitle>Nouvelle vente — Logiciel Pharmacie</PageTitle>

<div class="page-content pos-page">
    <header class="page-header pos-page-header">
        <div>
            <p class="pos-kicker">Ventes</p>
            <h1>Nouvelle vente</h1>
            <p class="page-subtitle">Continuité de vente avec données exclusivement synthétiques.</p>
        </div>
    </header>

    <UiAlert Title="Mode démonstration — aucune opération ne sera enregistrée"
             Variant="UiAlertVariant.Warning">
        Catalogue, paniers suspendus, paiements et impressions simulées restent uniquement en mémoire pendant cette session.
    </UiAlert>

    @if (Session.Step != DemoPosStep.Success)
    {
        <section class="pos-session-strip" aria-label="État de la vente de démonstration">
            <UiBadge Text="Vente de démonstration" Variant="UiBadgeVariant.Information" />
            <span><strong>Référence temporaire</strong> DEMO-BROUILLON</span>
            <span><strong>Lignes</strong> @Session.Lines.Count</span>
            <span><strong>Total</strong> @DemoMoney.Format(Session.Total)</span>
        </section>

        <nav class="pos-continuity-actions" aria-label="Actions de continuité de la vente">
            <UiButton Variant="UiButtonVariant.Secondary"
                      Disabled="@(!Session.CanSuspend || isCompleting)"
                      OnClick="RequestSuspendAsync">
                Suspendre la vente
            </UiButton>
            <UiButton Variant="UiButtonVariant.Danger"
                      Disabled="@(!Session.CanAbandon || isCompleting)"
                      OnClick="RequestAbandonAsync">
                Abandonner le brouillon
            </UiButton>
            <UiButton Variant="UiButtonVariant.Secondary"
                      aria-expanded="@showSuspendedSales.ToString().ToLowerInvariant()"
                      aria-controls="demo-suspended-sales"
                      OnClick="ToggleSuspendedSalesAsync">
                Ventes suspendues (@Session.SuspendedSales.Count)
            </UiButton>
        </nav>
    }

    @if (confirmationKind != ConfirmationKind.None)
    {
        <section class="pos-confirmation"
                 @ref="confirmationFocus"
                 tabindex="-1"
                 role="alertdialog"
                 aria-modal="true"
                 aria-labelledby="continuity-confirmation-title"
                 @onkeydown="HandleConfirmationKeyDownAsync">
            <div>
                <h2 id="continuity-confirmation-title">@ConfirmationTitle</h2>
                <p>@ConfirmationMessage</p>
            </div>
            <div class="pos-confirmation__actions">
                @if (confirmationKind == ConfirmationKind.ResumeConflict)
                {
                    <UiButton Variant="UiButtonVariant.Secondary" OnClick="CancelConfirmationAsync">
                        Revenir au panier courant
                    </UiButton>
                    <UiButton OnClick="ConfirmSuspendThenResumeAsync">
                        Suspendre le panier courant puis reprendre
                    </UiButton>
                    <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmAbandonThenResumeAsync">
                        Abandonner le panier courant puis reprendre
                    </UiButton>
                }
                else
                {
                    <UiButton Variant="UiButtonVariant.Secondary" OnClick="CancelConfirmationAsync">
                        Annuler
                    </UiButton>
                    @if (confirmationKind == ConfirmationKind.Suspend)
                    {
                        <UiButton OnClick="ConfirmSuspendAsync">Confirmer la suspension</UiButton>
                    }
                    else if (confirmationKind == ConfirmationKind.Abandon)
                    {
                        <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmAbandonAsync">
                            Confirmer l’abandon
                        </UiButton>
                    }
                    else if (confirmationKind == ConfirmationKind.DeleteSuspended)
                    {
                        <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmDeleteSuspendedAsync">
                            Confirmer la suppression
                        </UiButton>
                    }
                    else if (confirmationKind == ConfirmationKind.ResolveCardConfirmed)
                    {
                        <UiButton OnClick="ConfirmResolveCardConfirmedAsync">
                            Confirmer le paiement après vérification
                        </UiButton>
                    }
                    else if (confirmationKind == ConfirmationKind.ResolveCardNotCompleted)
                    {
                        <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmResolveCardNotCompletedAsync">
                            Confirmer le paiement non réalisé
                        </UiButton>
                    }
                    else if (confirmationKind == ConfirmationKind.ReturnCardToPaymentChoice)
                    {
                        <UiButton Variant="UiButtonVariant.Danger" OnClick="ConfirmReturnCardToPaymentChoiceAsync">
                            Confirmer le retour au choix du paiement
                        </UiButton>
                    }
                }
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(noticeMessage))
    {
        <p class="pos-notice" role="status" aria-live="polite">@noticeMessage</p>
    }

    @if (showSuspendedSales && Session.Step != DemoPosStep.Success)
    {
        <div id="demo-suspended-sales">
            <DemoSuspendedSalesPanel Sales="Session.SuspendedSales"
                                     OnResume="ResumeSuspendedAsync"
                                     OnDelete="RequestDeleteSuspendedAsync" />
        </div>
    }

    @if (Session.Step == DemoPosStep.Shopping)
    {
        <div class="pos-layout">
            <div class="pos-main-column">
                <section class="pos-search" aria-labelledby="demo-search-title">
                    <div class="pos-search__heading">
                        <div>
                            <p class="pos-kicker">Recherche locale</p>
                            <h2 id="demo-search-title">Rechercher ou scanner un code</h2>
                        </div>
                        <span>Entrée ajoute un code exact</span>
                    </div>
                    <label class="sr-only" for="demo-pos-search">Rechercher ou scanner un code</label>
                    <div class="pos-search__control">
                        <input id="demo-pos-search"
                               @ref="searchInput"
                               class="ui-field__control"
                               type="search"
                               autocomplete="off"
                               spellcheck="false"
                               placeholder="Nom fictif ou DEMO-000001"
                               value="@searchTerm"
                               aria-describedby="demo-search-help demo-search-message"
                               @oninput="HandleSearchInput"
                               @onkeydown="HandleSearchKeyDownAsync" />
                        <UiButton Variant="UiButtonVariant.Secondary"
                                  Disabled="@string.IsNullOrWhiteSpace(searchTerm)"
                                  OnClick="ClearSearchAsync">
                            Effacer la recherche
                        </UiButton>
                    </div>
                    <p id="demo-search-help" class="ui-field__help">
                        Recherche insensible à la casse, sans appel réseau ni création automatique.
                    </p>
                    <div id="demo-search-message" aria-live="polite">
                        @if (unknownCodeIncident)
                        {
                            <UiAlert Title="Code inconnu" Variant="UiAlertVariant.Warning">
                                <p>Aucun article de démonstration ne correspond à ce code. Aucun produit n’a été créé.</p>
                                <div class="pos-incident-actions">
                                    <UiButton Size="UiButtonSize.Small"
                                              Variant="UiButtonVariant.Secondary"
                                              OnClick="ClearSearchAsync">
                                        Effacer la recherche
                                    </UiButton>
                                    <UiButton Size="UiButtonSize.Small" OnClick="ReturnToCatalogAsync">
                                        Revenir au catalogue
                                    </UiButton>
                                </div>
                            </UiAlert>
                        }
                        else if (!string.IsNullOrWhiteSpace(searchTerm) && FilteredItems.Count == 0)
                        {
                            <p class="ui-field__error" role="status">
                                Aucun résultat dans le catalogue de démonstration.
                            </p>
                        }
                    </div>
                </section>

                <DemoCatalogPanel Items="FilteredItems" OnAdd="AddItemAsync" />
            </div>

            <aside class="pos-side-column" aria-label="Panier de démonstration">
                <DemoCartPanel Session="Session"
                               AvailabilityIncident="availabilityIncident"
                               OnDismissAvailability="DismissAvailabilityAsync"
                               OnIncrease="IncreaseAsync"
                               OnDecrease="DecreaseAsync"
                               OnRemove="RemoveAsync"
                               OnCheckout="BeginPaymentAsync" />
            </aside>
        </div>
    }
    else if (Session.Step == DemoPosStep.Payment)
    {
        <div class="pos-layout pos-layout--payment" @ref="paymentFocus" tabindex="-1">
            <div class="pos-main-column">
                <DemoPaymentPanel Session="Session"
                                  IsCompleting="isCompleting"
                                  OnBack="ReturnToCartAsync"
                                  OnConfirm="CompleteSaleAsync"
                                  OnResolveCardConfirmed="RequestResolveCardConfirmedAsync"
                                  OnResolveCardNotCompleted="RequestResolveCardNotCompletedAsync"
                                  OnReturnAmbiguousToPaymentChoice="RequestReturnCardToPaymentChoiceAsync" />
            </div>
            <aside class="pos-side-column" aria-label="Résumé du panier">
                <DemoCartPanel Session="Session" ReadOnly="true" />
            </aside>
        </div>
    }
    else if (Session.Result is not null)
    {
        <div @ref="successFocus" tabindex="-1" class="pos-success-focus">
            <DemoPosSuccess Session="Session"
                            OnNewSale="StartNewSaleAsync"
                            OnHome="ReturnHomeAsync" />
        </div>
    }
</div>

@code {
    private ElementReference searchInput;
    private ElementReference paymentFocus;
    private ElementReference successFocus;
    private ElementReference confirmationFocus;
    private string searchTerm = string.Empty;
    private string? noticeMessage;
    private string? pendingSuspendedReference;
    private DemoAvailabilityIncident? availabilityIncident;
    private bool unknownCodeIncident;
    private bool showSuspendedSales;
    private bool isCompleting;
    private ConfirmationKind confirmationKind;
    private FocusTarget requestedFocus = FocusTarget.Search;

    private IReadOnlyList<DemoCatalogItem> FilteredItems => Session.Search(searchTerm);

    private string ConfirmationTitle => confirmationKind switch
    {
        ConfirmationKind.Suspend => "Suspendre la vente courante ?",
        ConfirmationKind.Abandon => "Abandonner le brouillon ?",
        ConfirmationKind.DeleteSuspended => $"Supprimer {pendingSuspendedReference} ?",
        ConfirmationKind.ResumeConflict => "Un panier est déjà en cours",
        ConfirmationKind.ResolveCardConfirmed => "Confirmer le résultat du TPE ?",
        ConfirmationKind.ResolveCardNotCompleted => "Déclarer le paiement non réalisé ?",
        ConfirmationKind.ReturnCardToPaymentChoice => "Quitter le statut incertain ?",
        _ => string.Empty
    };

    private string ConfirmationMessage => confirmationKind switch
    {
        ConfirmationKind.Suspend =>
            "Les lignes et quantités seront conservées sous une référence temporaire. Le paiement courant ne sera pas conservé et la suspension disparaîtra à la fermeture de l’application.",
        ConfirmationKind.Abandon =>
            "Toutes les lignes et tout paiement incomplet du brouillon courant seront supprimés. Les ventes déjà suspendues resteront disponibles.",
        ConfirmationKind.DeleteSuspended =>
            "Cette vente suspendue en mémoire sera supprimée définitivement de la session de démonstration.",
        ConfirmationKind.ResumeConflict =>
            $"La reprise de {pendingSuspendedReference} ne doit pas écraser le panier courant. Choisissez explicitement de le conserver par suspension ou de l’abandonner.",
        ConfirmationKind.ResolveCardConfirmed =>
            "Confirmez uniquement après avoir vérifié le résultat affiché par le TPE externe simulé. Aucun nouveau paiement ne sera lancé.",
        ConfirmationKind.ResolveCardNotCompleted =>
            "Le paiement carte sera marqué non réalisé et la vente restera non validable jusqu’au choix explicite d’un paiement.",
        ConfirmationKind.ReturnCardToPaymentChoice =>
            "Le statut incertain sera effacé sans relancer de paiement. Vérifiez le TPE externe avant de choisir ensuite un nouveau mode de paiement.",
        _ => string.Empty
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && requestedFocus == FocusTarget.None)
        {
            return;
        }

        var target = firstRender ? FocusTarget.Search : requestedFocus;
        requestedFocus = FocusTarget.None;

        try
        {
            if (target == FocusTarget.Search && Session.Step == DemoPosStep.Shopping)
            {
                await searchInput.FocusAsync();
            }
            else if (target == FocusTarget.Payment && Session.Step == DemoPosStep.Payment)
            {
                await paymentFocus.FocusAsync();
            }
            else if (target == FocusTarget.Success && Session.Step == DemoPosStep.Success)
            {
                await successFocus.FocusAsync();
            }
            else if (target == FocusTarget.Confirmation && confirmationKind != ConfirmationKind.None)
            {
                await confirmationFocus.FocusAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // The native view can be closing while a local focus request is pending.
        }
    }

    private void HandleSearchInput(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? string.Empty;
        unknownCodeIncident = false;
        noticeMessage = null;
    }

    private async Task HandleSearchKeyDownAsync(KeyboardEventArgs args)
    {
        if (!string.Equals(args.Key, "Enter", StringComparison.Ordinal))
        {
            return;
        }

        var item = Session.FindExactCode(searchTerm);

        if (item is null)
        {
            unknownCodeIncident = true;
            noticeMessage = null;
            requestedFocus = FocusTarget.Search;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var result = Session.AddItem(item.Id);
        ApplyMutationMessage(result, item.Id);

        if (result != DemoCartMutationResult.AvailabilityReached)
        {
            searchTerm = string.Empty;
            unknownCodeIncident = false;
        }

        requestedFocus = FocusTarget.Search;
        await InvokeAsync(StateHasChanged);
    }

    private Task AddItemAsync(int itemId)
    {
        ApplyMutationMessage(Session.AddItem(itemId), itemId);
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private Task IncreaseAsync(int itemId)
    {
        ApplyMutationMessage(Session.Increase(itemId), itemId);
        return InvokeAsync(StateHasChanged);
    }

    private Task DecreaseAsync(int itemId)
    {
        ApplyMutationMessage(Session.Decrease(itemId), itemId);
        return InvokeAsync(StateHasChanged);
    }

    private Task RemoveAsync(int itemId)
    {
        ApplyMutationMessage(Session.Remove(itemId), itemId);
        return InvokeAsync(StateHasChanged);
    }

    private Task BeginPaymentAsync()
    {
        if (Session.BeginPayment())
        {
            CloseConfirmation();
            availabilityIncident = null;
            noticeMessage = null;
            requestedFocus = FocusTarget.Payment;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task ReturnToCartAsync()
    {
        Session.ReturnToShopping();
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private async Task CompleteSaleAsync()
    {
        if (!Session.TryBeginCompletion())
        {
            return;
        }

        isCompleting = true;
        CloseConfirmation();

        try
        {
            await Task.Delay(180);
            Session.CompleteSale();
            requestedFocus = FocusTarget.Success;
        }
        catch
        {
            Session.CancelCompletion();
            throw;
        }
        finally
        {
            isCompleting = false;
        }
    }

    private Task RequestSuspendAsync(MouseEventArgs _)
    {
        return ShowConfirmationAsync(ConfirmationKind.Suspend);
    }

    private Task ConfirmSuspendAsync(MouseEventArgs _)
    {
        var suspended = Session.SuspendCurrent();
        CloseConfirmation();

        if (suspended is not null)
        {
            searchTerm = string.Empty;
            unknownCodeIncident = false;
            availabilityIncident = null;
            showSuspendedSales = true;
            noticeMessage = $"Vente suspendue sous {suspended.Reference}. Temporaire en mémoire : elle disparaîtra à la fermeture.";
            requestedFocus = FocusTarget.Search;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task RequestAbandonAsync(MouseEventArgs _)
    {
        return ShowConfirmationAsync(ConfirmationKind.Abandon);
    }

    private Task ConfirmAbandonAsync(MouseEventArgs _)
    {
        var abandoned = Session.AbandonDraft();
        CloseConfirmation();

        if (abandoned)
        {
            searchTerm = string.Empty;
            unknownCodeIncident = false;
            availabilityIncident = null;
            noticeMessage = "Brouillon abandonné. Aucune vente ni aucun paiement n’a été créé.";
            requestedFocus = FocusTarget.Search;
        }

        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleSuspendedSalesAsync(MouseEventArgs _)
    {
        showSuspendedSales = !showSuspendedSales;
        return InvokeAsync(StateHasChanged);
    }

    private Task ResumeSuspendedAsync(string reference)
    {
        var result = Session.ResumeSuspended(reference);

        if (result == DemoResumeResult.CurrentCartNotEmpty)
        {
            pendingSuspendedReference = reference;
            return ShowConfirmationAsync(ConfirmationKind.ResumeConflict);
        }

        ApplyResumeResult(result, reference);
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmSuspendThenResumeAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        var result = reference is null
            ? DemoResumeResult.NotFound
            : Session.SuspendCurrentThenResume(reference);
        CloseConfirmation();
        ApplyResumeResult(result, reference);
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmAbandonThenResumeAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        var result = reference is null
            ? DemoResumeResult.NotFound
            : Session.AbandonCurrentThenResume(reference);
        CloseConfirmation();
        ApplyResumeResult(result, reference);
        return InvokeAsync(StateHasChanged);
    }

    private Task RequestDeleteSuspendedAsync(string reference)
    {
        pendingSuspendedReference = reference;
        return ShowConfirmationAsync(ConfirmationKind.DeleteSuspended);
    }

    private Task ConfirmDeleteSuspendedAsync(MouseEventArgs _)
    {
        var reference = pendingSuspendedReference;
        var deleted = reference is not null && Session.DeleteSuspended(reference);
        CloseConfirmation();
        noticeMessage = deleted
            ? $"Vente suspendue {reference} supprimée de la mémoire de démonstration. Aucune vente réelle n’a été annulée."
            : "La vente suspendue n’est plus disponible.";
        requestedFocus = Session.Step == DemoPosStep.Shopping ? FocusTarget.Search : FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task RequestResolveCardConfirmedAsync()
    {
        return ShowConfirmationAsync(ConfirmationKind.ResolveCardConfirmed);
    }

    private Task RequestResolveCardNotCompletedAsync()
    {
        return ShowConfirmationAsync(ConfirmationKind.ResolveCardNotCompleted);
    }

    private Task RequestReturnCardToPaymentChoiceAsync()
    {
        return ShowConfirmationAsync(ConfirmationKind.ReturnCardToPaymentChoice);
    }

    private Task ConfirmResolveCardConfirmedAsync(MouseEventArgs _)
    {
        Session.ResolveAmbiguousCardAsConfirmed();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmResolveCardNotCompletedAsync(MouseEventArgs _)
    {
        Session.ResolveAmbiguousCardAsNotCompleted();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ConfirmReturnCardToPaymentChoiceAsync(MouseEventArgs _)
    {
        Session.ReturnToPaymentChoice();
        CloseConfirmation();
        requestedFocus = FocusTarget.Payment;
        return InvokeAsync(StateHasChanged);
    }

    private Task ShowConfirmationAsync(ConfirmationKind kind)
    {
        confirmationKind = kind;
        noticeMessage = null;
        requestedFocus = FocusTarget.Confirmation;
        return InvokeAsync(StateHasChanged);
    }

    private Task CancelConfirmationAsync(MouseEventArgs _)
    {
        CloseConfirmation();
        requestedFocus = Session.Step switch
        {
            DemoPosStep.Payment => FocusTarget.Payment,
            DemoPosStep.Success => FocusTarget.Success,
            _ => FocusTarget.Search
        };
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleConfirmationKeyDownAsync(KeyboardEventArgs args)
    {
        return string.Equals(args.Key, "Escape", StringComparison.Ordinal)
            ? CancelConfirmationAsync(new MouseEventArgs())
            : Task.CompletedTask;
    }

    private Task ClearSearchAsync(MouseEventArgs _)
    {
        searchTerm = string.Empty;
        unknownCodeIncident = false;
        noticeMessage = null;
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private Task ReturnToCatalogAsync(MouseEventArgs _)
    {
        searchTerm = string.Empty;
        unknownCodeIncident = false;
        noticeMessage = null;
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private Task DismissAvailabilityAsync()
    {
        availabilityIncident = null;
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private Task StartNewSaleAsync()
    {
        ResetPageState();
        requestedFocus = FocusTarget.Search;
        return InvokeAsync(StateHasChanged);
    }

    private void ReturnHomeAsync()
    {
        ResetPageState();
        Navigation.NavigateTo("/home");
    }

    private void ApplyResumeResult(DemoResumeResult result, string? reference)
    {
        if (result == DemoResumeResult.Resumed)
        {
            searchTerm = string.Empty;
            unknownCodeIncident = false;
            availabilityIncident = null;
            noticeMessage = $"Vente suspendue {reference} reprise. Le paiement doit être choisi à nouveau.";
            requestedFocus = FocusTarget.Search;
        }
        else if (result != DemoResumeResult.CurrentCartNotEmpty)
        {
            noticeMessage = "La vente suspendue n’est plus disponible.";
        }
    }

    private void ApplyMutationMessage(DemoCartMutationResult result, int itemId)
    {
        unknownCodeIncident = false;

        if (result == DemoCartMutationResult.AvailabilityReached)
        {
            var item = Session.FindLine(itemId)?.Item
                ?? Session.Catalog.First(candidate => candidate.Id == itemId);
            availabilityIncident = new DemoAvailabilityIncident(item.Name, item.AvailableQuantity);
            noticeMessage = null;
            return;
        }

        availabilityIncident = null;
        noticeMessage = result switch
        {
            DemoCartMutationResult.Added => "Article de démonstration ajouté au panier.",
            DemoCartMutationResult.Merged => "Article déjà présent : quantité augmentée.",
            DemoCartMutationResult.Increased => "Quantité augmentée.",
            DemoCartMutationResult.Decreased => "Quantité diminuée.",
            DemoCartMutationResult.Removed => "Ligne retirée du panier.",
            DemoCartMutationResult.MinimumReached => "La quantité minimale est 1. Utilisez Supprimer pour retirer la ligne.",
            _ => "Aucune modification effectuée."
        };
    }

    private void CloseConfirmation()
    {
        confirmationKind = ConfirmationKind.None;
        pendingSuspendedReference = null;
    }

    private void ResetPageState()
    {
        Session.ResetForNewSale();
        searchTerm = string.Empty;
        unknownCodeIncident = false;
        availabilityIncident = null;
        noticeMessage = null;
        showSuspendedSales = false;
        isCompleting = false;
        CloseConfirmation();
    }

    private enum ConfirmationKind
    {
        None,
        Suspend,
        Abandon,
        DeleteSuspended,
        ResumeConflict,
        ResolveCardConfirmed,
        ResolveCardNotCompleted,
        ReturnCardToPaymentChoice
    }

    private enum FocusTarget
    {
        None,
        Search,
        Payment,
        Success,
        Confirmation
    }
}
