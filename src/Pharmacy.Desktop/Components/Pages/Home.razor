@page "/"
@page "/home"
@inject IPermissionAuthorizer Authorizer

<PageTitle>Accueil — Logiciel Pharmacie</PageTitle>

<div class="home-page page-content">
    <header class="page-header" aria-labelledby="home-title">
        <div>
            <h1 id="home-title" tabindex="-1">Accueil</h1>
        </div>
    </header>

    <section aria-labelledby="quick-actions-title">
        <div class="content-section-heading">
            <div>
                <h2 id="quick-actions-title">Accès directs</h2>
            </div>
        </div>
        <div class="quick-actions">
            @foreach (var action in HomePresentationModel.QuickActions.Where(CanAccess))
            {
                <a class="quick-action" href="@action.Route">
                    <span class="quick-action__icon" aria-hidden="true"><UiIcon Name="@action.Icon" /></span>
                    <span>
                        <strong>@action.Label</strong>
                        <small>@action.Description</small>
                    </span>
                    <span class="quick-action__chevron" aria-hidden="true"><UiIcon Name="UiIconName.Chevron" /></span>
                </a>
            }
        </div>
    </section>
</div>

@code {
    private bool CanAccess(DemoQuickAction action) => Authorizer.Authorize(action.RequiredPermission).IsSuccess;
}
