@using System.Globalization

<section class="pos-panel pos-payment" aria-labelledby="demo-payment-title">
    <header class="pos-panel__header">
        <div>
            <p class="pos-kicker">Étape de règlement</p>
            <h2 id="demo-payment-title">Paiement de la vente</h2>
        </div>
        <strong class="pos-payment__total">@DemoMoney.Format(Session.Total)</strong>
    </header>

    <fieldset class="pos-payment-methods" disabled="@IsCompleting">
        <legend>Choisir un mode de paiement</legend>
        <label class="pos-payment-option">
            <input type="radio"
                   name="demo-payment-method"
                   value="cash"
                   checked="@(Session.PaymentMethod == DemoPaymentMethod.Cash)"
                   @onchange="SelectCash" />
            <span>
                <strong>Espèces</strong>
                <small>Calcul local de la monnaie</small>
            </span>
        </label>
        <label class="pos-payment-option">
            <input type="radio"
                   name="demo-payment-method"
                   value="card"
                   checked="@(Session.PaymentMethod == DemoPaymentMethod.ExternalCard)"
                   @onchange="SelectCard" />
            <span>
                <strong>Carte — TPE externe</strong>
                <small>Vérification opérateur sans saisie bancaire</small>
            </span>
        </label>
    </fieldset>

    @if (Session.PaymentMethod == DemoPaymentMethod.Cash)
    {
        <div class="pos-payment-detail">
            <label class="ui-field__label" for="demo-received-amount">Montant reçu</label>
            <div class="pos-money-input">
                <input id="demo-received-amount"
                       class="ui-field__control"
                       type="text"
                       inputmode="decimal"
                       autocomplete="off"
                       value="@cashInput"
                       aria-invalid="@HasCashError.ToString().ToLowerInvariant()"
                       aria-describedby="demo-cash-help demo-cash-status"
                       disabled="@IsCompleting"
                       @oninput="HandleCashInput" />
                <span>MAD</span>
            </div>
            <p id="demo-cash-help" class="ui-field__help">Saisissez un montant positif avec une virgule ou un point.</p>
            <div id="demo-cash-status" class="pos-payment-status" aria-live="polite">
                @if (!string.IsNullOrWhiteSpace(cashError))
                {
                    <p class="ui-field__error">Erreur : @cashError</p>
                }
                else if (Session.ReceivedAmount is not null && Session.ReceivedAmount.Value < Session.Total)
                {
                    <p class="ui-field__error">Montant insuffisant. Il manque @DemoMoney.Format(Session.Total - Session.ReceivedAmount.Value).</p>
                }
                else if (Session.ReceivedAmount is not null)
                {
                    <p class="pos-change">Monnaie à rendre : <strong>@DemoMoney.Format(Session.Change)</strong></p>
                }
            </div>
        </div>
    }
    else if (Session.PaymentMethod == DemoPaymentMethod.ExternalCard)
    {
        <div class="pos-payment-detail pos-terminal-state">
            <UiAlert Title="TPE externe — aucune donnée de carte n’est saisie dans le logiciel"
                     Variant="UiAlertVariant.Information">
                Le terminal reste entièrement hors du logiciel. Le résultat est confirmé manuellement par l’opérateur et aucune donnée bancaire n’est collectée.
            </UiAlert>

            <div class="pos-terminal-state__header">
                <strong>État du paiement carte</strong>
                <UiBadge Text="@CardStatusLabel" Variant="@CardStatusVariant" />
            </div>

            @if (Session.CardPaymentStatus == DemoCardPaymentStatus.NotStarted)
            {
                <UiButton OnClick="StartCardVerificationAsync">
                    Déclarer la vérification du TPE
                </UiButton>
            }
            else if (Session.CardPaymentStatus == DemoCardPaymentStatus.AwaitingConfirmation)
            {
                <p>Après lecture du TPE externe simulé, choisissez explicitement le résultat observé.</p>
                <div class="pos-terminal-actions">
                    <UiButton OnClick="ReportCardConfirmedAsync">Paiement confirmé</UiButton>
                    <UiButton Variant="UiButtonVariant.Secondary" OnClick="ReportCardNotCompletedAsync">
                        Paiement non réalisé
                    </UiButton>
                    <UiButton Variant="UiButtonVariant.Danger" OnClick="ReportCardAmbiguousAsync">
                        Statut incertain
                    </UiButton>
                </div>
            }
            else if (Session.CardPaymentStatus == DemoCardPaymentStatus.Confirmed)
            {
                <UiAlert Title="Paiement confirmé après vérification du TPE"
                         Variant="UiAlertVariant.Success">
                    La vente peut maintenant être confirmée. Aucune donnée bancaire n’a été stockée.
                </UiAlert>
            }
            else if (Session.CardPaymentStatus == DemoCardPaymentStatus.NotCompleted)
            {
                <UiAlert Title="Paiement non réalisé"
                         Variant="UiAlertVariant.Warning">
                    Aucun paiement carte n’est retenu et la validation de la vente reste bloquée.
                </UiAlert>
                <UiButton Variant="UiButtonVariant.Secondary" OnClick="ReturnToPaymentChoiceAsync">
                    Retour au choix du paiement
                </UiButton>
            }
            else if (Session.CardPaymentStatus == DemoCardPaymentStatus.Ambiguous)
            {
                <UiAlert Title="Statut du paiement incertain"
                         Variant="UiAlertVariant.Danger">
                    <p>Vérifiez le TPE externe avant de poursuivre. Ne relancez pas automatiquement un nouveau paiement.</p>
                    <div class="pos-terminal-actions">
                        <UiButton OnClick="ResolveConfirmedAsync">
                            Confirmer après vérification du TPE
                        </UiButton>
                        <UiButton Variant="UiButtonVariant.Secondary" OnClick="ResolveNotCompletedAsync">
                            Déclarer le paiement non réalisé
                        </UiButton>
                        <UiButton Variant="UiButtonVariant.Danger" OnClick="RequestReturnAmbiguousToPaymentChoiceAsync">
                            Retour au choix du paiement
                        </UiButton>
                    </div>
                </UiAlert>
            }

            <small>Vérifications TPE déclarées : @Session.CardVerificationCount</small>
        </div>
    }
    else
    {
        <p class="pos-payment-placeholder">Sélectionnez Espèces ou Carte — TPE externe.</p>
    }

    <footer class="pos-payment__actions">
        <UiButton Variant="UiButtonVariant.Secondary"
                  Disabled="@IsCompleting"
                  OnClick="BackAsync">
            Retour au panier
        </UiButton>
        <UiButton Size="UiButtonSize.Large"
                  Disabled="@(!Session.CanComplete || IsCompleting)"
                  IsLoading="@IsCompleting"
                  LoadingText="Commit SQL en cours"
                  OnClick="ConfirmAsync">
            Confirmer et enregistrer la vente
        </UiButton>
    </footer>
</section>

@code {
    private string cashInput = string.Empty;
    private string? cashError;

    [Parameter, EditorRequired]
    public SalesPosCoordinator Session { get; set; } = default!;

    [Parameter]
    public bool IsCompleting { get; set; }

    [Parameter]
    public EventCallback OnBack { get; set; }

    [Parameter]
    public EventCallback OnConfirm { get; set; }

    [Parameter]
    public EventCallback OnResolveCardConfirmed { get; set; }

    [Parameter]
    public EventCallback OnResolveCardNotCompleted { get; set; }

    [Parameter]
    public EventCallback OnReturnAmbiguousToPaymentChoice { get; set; }

    private bool HasCashError => !string.IsNullOrWhiteSpace(cashError)
        || Session.ReceivedAmount is not null && Session.ReceivedAmount.Value < Session.Total;

    private string CardStatusLabel => Session.CardPaymentStatus switch
    {
        DemoCardPaymentStatus.AwaitingConfirmation => "Vérification en attente",
        DemoCardPaymentStatus.Confirmed => "Confirmé",
        DemoCardPaymentStatus.NotCompleted => "Non réalisé",
        DemoCardPaymentStatus.Ambiguous => "Incertain — action requise",
        _ => "Non démarré"
    };

    private UiBadgeVariant CardStatusVariant => Session.CardPaymentStatus switch
    {
        DemoCardPaymentStatus.Confirmed => UiBadgeVariant.Success,
        DemoCardPaymentStatus.Ambiguous => UiBadgeVariant.Danger,
        DemoCardPaymentStatus.NotCompleted => UiBadgeVariant.Warning,
        _ => UiBadgeVariant.Information
    };

    private void SelectCash(ChangeEventArgs _)
    {
        Session.SelectPaymentMethod(DemoPaymentMethod.Cash);
        cashInput = string.Empty;
        cashError = null;
    }

    private void SelectCard(ChangeEventArgs _)
    {
        Session.SelectPaymentMethod(DemoPaymentMethod.ExternalCard);
        cashInput = string.Empty;
        cashError = null;
    }

    private void HandleCashInput(ChangeEventArgs args)
    {
        cashInput = args.Value?.ToString()?.Trim() ?? string.Empty;
        cashError = null;

        if (string.IsNullOrWhiteSpace(cashInput))
        {
            Session.SetReceivedAmount(null);
            return;
        }

        var normalized = cashInput.Replace(',', '.');

        if (!decimal.TryParse(
                normalized,
                NumberStyles.AllowDecimalPoint,
                CultureInfo.InvariantCulture,
                out var amount)
            || amount < 0m)
        {
            Session.SetReceivedAmount(null);
            cashError = "Saisissez un montant positif valide.";
            return;
        }

        Session.SetReceivedAmount(amount);
    }

    private Task StartCardVerificationAsync(MouseEventArgs _)
    {
        Session.StartExternalCardVerification();
        return Task.CompletedTask;
    }

    private Task ReportCardConfirmedAsync(MouseEventArgs _)
    {
        Session.ReportExternalCardConfirmed();
        return Task.CompletedTask;
    }

    private Task ReportCardNotCompletedAsync(MouseEventArgs _)
    {
        Session.ReportExternalCardNotCompleted();
        return Task.CompletedTask;
    }

    private Task ReportCardAmbiguousAsync(MouseEventArgs _)
    {
        Session.ReportExternalCardAmbiguous();
        return Task.CompletedTask;
    }

    private Task ResolveConfirmedAsync(MouseEventArgs _)
    {
        return OnResolveCardConfirmed.InvokeAsync();
    }

    private Task ResolveNotCompletedAsync(MouseEventArgs _)
    {
        return OnResolveCardNotCompleted.InvokeAsync();
    }

    private Task ReturnToPaymentChoiceAsync(MouseEventArgs _)
    {
        Session.ReturnToPaymentChoice();
        return Task.CompletedTask;
    }

    private Task RequestReturnAmbiguousToPaymentChoiceAsync(MouseEventArgs _)
    {
        return OnReturnAmbiguousToPaymentChoice.InvokeAsync();
    }

    private Task BackAsync(MouseEventArgs _)
    {
        return OnBack.InvokeAsync();
    }

    private Task ConfirmAsync(MouseEventArgs _)
    {
        return OnConfirm.InvokeAsync();
    }
}
