<section class="pos-panel" aria-labelledby="demo-catalog-title">
    <header class="pos-panel__header">
        <div>
            <h2 id="demo-catalog-title">Produits</h2>
        </div>
        <span class="pos-result-count">@Items.Count résultat(s)</span>
    </header>

    @if (Items.Count > 0)
    {
        <ul class="pos-catalog-list">
            @foreach (var item in Items)
            {
                <li class="pos-catalog-item" @key="item.ProductId.Value">
                    <div class="pos-catalog-item__copy">
                        <strong>@item.DisplayName</strong>
                        <span>@item.Presentation</span>
                        <code>@item.Reference.Value</code>
                    </div>
                    <div class="pos-catalog-item__facts">
                        <span class="pos-price-label">Prix</span>
                        <strong>@DemoMoney.Format(item.UnitSalePrice.Amount)</strong>
                        <small>Disponible : @item.AvailableQuantity</small>
                    </div>
                    <UiButton Size="UiButtonSize.Small"
                              Disabled="@(IsBusy || !item.IsAvailable)"
                              IsLoading="@(IsBusy && BusyProductId == item.ProductId)"
                              LoadingText="Ajout en cours"
                              OnClick="args => AddAsync(item.ProductId, args)">
                        Ajouter
                    </UiButton>
                </li>
            }
        </ul>
    }
</section>

@code {
    [Parameter]
    public IReadOnlyList<SellableProductView> Items { get; set; } = Array.Empty<SellableProductView>();

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public ProductId? BusyProductId { get; set; }

    [Parameter]
    public EventCallback<ProductId> OnAdd { get; set; }

    private Task AddAsync(ProductId productId, MouseEventArgs _)
    {
        return OnAdd.InvokeAsync(productId);
    }
}
