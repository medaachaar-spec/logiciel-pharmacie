<section class="pos-panel pos-cart" aria-labelledby="demo-cart-title">
    <header class="pos-panel__header">
        <div>
            <p class="pos-kicker">Panier courant</p>
            <h2 id="demo-cart-title">@Lines.Count ligne(s)</h2>
        </div>
        <span class="pos-cart__quantity">@Session.TotalQuantity article(s)</span>
    </header>

    @if (AvailabilityIncident is not null)
    {
        <UiAlert Title="Quantité indisponible dans le catalogue de démonstration."
                 Variant="UiAlertVariant.Warning"
                 Dismissible="true"
                 OnDismiss="OnDismissAvailability">
            <p>
                Article : <strong>@AvailabilityIncident.ProductName</strong> — quantité demandée :
                <strong>@AvailabilityIncident.RequestedQuantity</strong> — quantité disponible :
                <strong>@AvailabilityIncident.AvailableQuantity</strong>. Le panier existant est conservé.
            </p>
        </UiAlert>
    }

    @if (Lines.Count == 0)
    {
        <UiEmptyState Title="Le panier est vide"
                      Description="Recherchez un article ou saisissez un code de démonstration." />
    }
    else
    {
        <ul class="pos-cart-list">
            @foreach (var line in Lines)
            {
                <li class="pos-cart-line" @key="line.ProductId.Value">
                    <div class="pos-cart-line__heading">
                        <span>
                            <strong>@line.DisplayName</strong>
                            <code>@line.Reference.Value</code>
                        </span>
                        <strong>@DemoMoney.Format(line.Subtotal.Amount)</strong>
                    </div>
                    <p>Prix unitaire : @DemoMoney.Format(line.UnitPrice.Amount)</p>

                    @if (ReadOnly)
                    {
                        <span class="pos-cart-line__readonly">Quantité : @line.Quantity.Value</span>
                    }
                    else
                    {
                        <div class="pos-cart-line__actions">
                            <div class="pos-quantity-control" aria-label="Quantité de @line.DisplayName">
                                <button type="button"
                                        aria-label="Diminuer la quantité de @line.DisplayName"
                                        disabled="@(line.Quantity.Value <= 1 || Session.IsCartMutationInProgress)"
                                        @onclick="() => OnDecrease.InvokeAsync(line.ProductId)">−</button>
                                <output aria-live="polite" aria-label="Quantité">@line.Quantity.Value</output>
                                <button type="button"
                                        aria-label="Augmenter la quantité de @line.DisplayName"
                                        disabled="@Session.IsCartMutationInProgress"
                                        @onclick="() => OnIncrease.InvokeAsync(line.ProductId)">+</button>
                            </div>
                            <button type="button"
                                    class="pos-remove-button"
                                    aria-label="Supprimer @line.DisplayName du panier"
                                    disabled="@Session.IsCartMutationInProgress"
                                    @onclick="() => OnRemove.InvokeAsync(line.ProductId)">
                                Supprimer
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    <footer class="pos-cart__footer">
        <span>Total</span>
        <strong>@DemoMoney.Format(Session.Total)</strong>
        @if (!ReadOnly)
        {
            <UiButton Size="UiButtonSize.Large"
                      Disabled="@(Lines.Count == 0 || Session.IsCartMutationInProgress)"
                      OnClick="CheckoutAsync">
                Passer au paiement
            </UiButton>
        }
    </footer>
</section>

@code {
    [Parameter, EditorRequired]
    public SalesPosCoordinator Session { get; set; } = default!;

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter]
    public SalesPosAvailabilityIncident? AvailabilityIncident { get; set; }

    [Parameter]
    public EventCallback OnDismissAvailability { get; set; }

    [Parameter]
    public EventCallback<ProductId> OnIncrease { get; set; }

    [Parameter]
    public EventCallback<ProductId> OnDecrease { get; set; }

    [Parameter]
    public EventCallback<ProductId> OnRemove { get; set; }

    [Parameter]
    public EventCallback OnCheckout { get; set; }

    private IReadOnlyList<SaleDraftLineView> Lines => Session.CurrentDraft?.Lines
        ?? Array.Empty<SaleDraftLineView>();

    private Task CheckoutAsync(MouseEventArgs _)
    {
        return OnCheckout.InvokeAsync();
    }
}
