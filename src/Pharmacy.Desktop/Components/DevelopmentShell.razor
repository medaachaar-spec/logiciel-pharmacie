<div class="development-shell">
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>
    <header class="development-bar">
        <div class="development-bar__inner">
            <div class="development-brand">
                <strong>Logiciel Pharmacie</strong>
                <span>Outils internes</span>
            </div>
            <nav class="development-nav" aria-label="Outils internes">
                <NavLink href="" Match="NavLinkMatch.All">Diagnostic technique</NavLink>
                <NavLink href="ui-lab">UI Lab</NavLink>
            </nav>
        </div>
    </header>
    <main id="main-content" class="development-main" tabindex="-1">
        @ChildContent
