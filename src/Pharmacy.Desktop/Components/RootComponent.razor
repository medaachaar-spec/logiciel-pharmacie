@implements IDisposable
@inject SecurityCoordinator Security
@inject BrandingCoordinator Branding
@inject ICurrentSecuritySession Session
@inject ISecurityClock SecurityClock

<div class="branding-root" style="@Branding.ThemeStyle">
    @if (!Security.IsInitialized)
    {
        <p class="loading-message" role="status">Chargement…</p>
    }
    else if (!Session.IsAuthenticated)
    {
        <SecurityEntry />
    }
    else if (Session.IsLocked)
    {
        <SecurityLockScreen />
    }
    else if (Security.MustChangePassword)
    {
        <SecurityPasswordChangeRequired />
    }
    else
    {
        <div @onclick="RecordActivity" @onkeydown="RecordActivity">
            <Router AppAssembly="@typeof(RootComponent).Assembly">
                <Found Context="routeData">
                    <RouteView RouteData="@routeData" DefaultLayout="@typeof(AppShellLayout)" />
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <LayoutView Layout="@typeof(AppShellLayout)">
                        <DynamicComponent Type="@typeof(Pharmacy.Desktop.Components.Pages.NotFound)" />
                    </LayoutView>
                </NotFound>
            </Router>
        </div>
    }
</div>

@code {
    private System.Threading.Timer? inactivityTimer;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += HandleSessionChanged;
        Branding.Changed += HandleBrandingChanged;
        await Branding.InitializeAsync();
        await Security.InitializeAsync();
        inactivityTimer = new System.Threading.Timer(CheckInactivity, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose()
    {
        Session.Changed -= HandleSessionChanged;
        Branding.Changed -= HandleBrandingChanged;
        inactivityTimer?.Dispose();
        GC.SuppressFinalize(this);
    }

    private void RecordActivity() => Session.Touch(SecurityClock.UtcNow);

    private void CheckInactivity(object? state)
    {
        if (Session.LockIfInactive(SecurityClock.UtcNow))
        {
            _ = InvokeAsync(async () =>
            {
                await Security.LockAsync();
                StateHasChanged();
            });
        }
    }

    private void HandleSessionChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleBrandingChanged() => _ = InvokeAsync(StateHasChanged);
}
