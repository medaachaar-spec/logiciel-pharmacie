@inject SecurityCoordinator Security

<main class="security-stage">
    <section class="security-card" aria-labelledby="password-change-title">
        <p class="security-card__kicker">Action obligatoire</p>
        <h1 id="password-change-title">Changer le mot de passe initial</h1>
        <p class="security-card__intro">Le shell métier restera inaccessible tant que le mot de passe fourni par l’administrateur n’aura pas été remplacé.</p>
        @if (!string.IsNullOrWhiteSpace(Security.Message)) { <div class="security-feedback" role="alert">@Security.Message</div> }
        <form @onsubmit="ChangeAsync" @onsubmit:preventDefault>
            <label>Mot de passe actuel<input type="password" autocomplete="current-password" autofocus @bind="currentPassword" /></label>
            <label>Nouveau mot de passe<input type="password" autocomplete="new-password" @bind="newPassword" /></label>
            <small>15 à 128 caractères ; ne réutilisez pas un mot de passe courant.</small>
            <button class="security-primary" disabled="@Security.IsBusy">Changer et continuer</button>
            <button type="button" @onclick="LogoutAsync">Annuler et se déconnecter</button>
        </form>
    </section>
</main>

@code {
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private async Task ChangeAsync()
    {
        await Security.ChangePasswordAsync(currentPassword, newPassword);
        currentPassword = newPassword = string.Empty;
    }
    private Task LogoutAsync() => Security.LogoutAsync();
}
