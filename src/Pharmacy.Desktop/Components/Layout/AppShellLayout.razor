@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Routing
@using Pharmacy.Desktop.Components.Navigation
@inject NavigationManager NavigationManager
@inject ICurrentSecuritySession SecuritySession
@inject IPermissionAuthorizer PermissionAuthorizer

<div class="app-shell @(isSidebarCollapsed ? "app-shell--collapsed" : null)">
    <a class="skip-link" href="#main-content">Aller au contenu principal</a>

    <AppSidebar Items="@AppNavigationCatalog.Items"
                AccessProfile="@selectedProfile"
                CurrentPath="@currentPath"
                IsCollapsed="@isSidebarCollapsed"
                OnToggleCollapsed="ToggleSidebar"
                Allowed="CanAccess" />

    <AppTopBar PageTitle="@CurrentPageTitle"
               PageDescription="@CurrentPageDescription"
               ShowPageContext="@(!IsHome)" />

    <main id="main-content" class="app-main" tabindex="-1">
        @Body
    </main>

    <AppStatusBar />
</div>

@code {
    private bool isSidebarCollapsed;
    private string currentPath = "/";
    private AppNavigationItem? currentItem;
    private DevelopmentAccessProfile selectedProfile = DevelopmentAccessCatalog.Default;

    private string CurrentPageTitle => currentItem?.Label ?? "Page introuvable";

    private string CurrentPageDescription => PermissionAwarePageDescription.Resolve(
        currentItem?.Id,
        currentItem?.Description ?? "Cette adresse ne correspond à aucun écran disponible.",
        permission => PermissionAuthorizer.Authorize(permission).IsSuccess);

    private bool IsHome => currentPath is "/" or "/home";

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        UpdateCurrentLocation();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
        GC.SuppressFinalize(this);
    }

    private void ToggleSidebar()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private bool CanAccess(AppNavigationItem item)
    {
        return string.IsNullOrWhiteSpace(item.RequiredPermission)
            || PermissionAuthorizer.Authorize(item.RequiredPermission).IsSuccess;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateCurrentLocation();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateCurrentLocation()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        currentPath = NormalizePath(relativePath);
        currentItem = AppNavigationCatalog.FindByRoute(currentPath)
            ?? AppNavigationCatalog.FindModule(currentPath.Split('/').LastOrDefault());
    }

    private static string NormalizePath(string path)
    {
        var routeOnly = path.Split('?', '#')[0];
        var normalized = $"/{routeOnly.Trim('/')}";
        return normalized.Length == 1 ? "/" : normalized;
    }
}
