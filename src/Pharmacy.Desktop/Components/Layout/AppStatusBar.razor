@if (!string.IsNullOrWhiteSpace(Message))
{
    <footer class="app-statusbar" aria-label="État de l’application" role="status">
        <span><span class="app-statusbar__dot" aria-hidden="true"></span>@Message</span>
    </footer>
}

@code {
    [Parameter]
    public string? Message { get; set; }
}
