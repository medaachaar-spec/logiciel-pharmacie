@inject ICurrentSecuritySession Session
@inject SecurityCoordinator Security

<header class="app-topbar">
    <div class="app-topbar__heading">
        <h2>@PageTitle</h2>
        <p>@PageDescription</p>
    </div>
    <div class="app-topbar__context">
        <div class="app-topbar__badges" aria-label="Rôles du compte">
            @foreach (var role in Session.User?.Roles ?? Array.Empty<string>()) { <span class="context-badge">@role</span> }
        </div>
        <div class="app-topbar__account" aria-label="Compte courant">
            <span class="app-topbar__avatar" aria-hidden="true">@Initials</span>
            <span><strong>@Session.User?.DisplayName</strong><small>@Session.User?.Login</small></span>
            <button type="button" class="security-topbar-button" @onclick="LockAsync">Verrouiller</button>
            <button type="button" class="security-topbar-button" @onclick="LogoutAsync">Déconnexion</button>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public string PageTitle { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string PageDescription { get; set; } = string.Empty;
    private string Initials => string.Concat((Session.User?.DisplayName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])).ToUpperInvariant();
    private Task LockAsync() => Security.LockAsync();
    private Task LogoutAsync() => Security.LogoutAsync();
}
