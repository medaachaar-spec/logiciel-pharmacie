<span class="ui-spinner ui-spinner--@SizeClass" role="status" aria-live="polite">
    <span class="ui-spinner__indicator" aria-hidden="true"></span>
    @if (ShowLabel)
    {
        <span class="ui-spinner__label">@Label</span>
    }
    else
    {
        <span class="sr-only">@Label</span>
    }
</span>

@code {
    [Parameter]
    public UiSpinnerSize Size { get; set; } = UiSpinnerSize.Medium;

    [Parameter]
    public string Label { get; set; } = "Chargement en cours";

    [Parameter]
    public bool ShowLabel { get; set; }

    private string SizeClass => Size.ToString().ToLowerInvariant();
}
